{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // report exports unused even from entry files themselves
  "includeEntryExports": true,
  "tags": [
    "-lintignore"
  ],
  // TEMP: claude-plugin is the only consumer of these exports
  "ignoreIssues": {
    "packages/shared/src/core/config.ts": ["exports"],
    "packages/shared/src/core/helpers/namespace.helpers.ts": ["exports"],
    "packages/shared/src/core/loccy-config/regional-override-guards.ts": ["exports", "types"],
    "packages/shared/src/core/resources/linked-refs.ts": ["exports"],
    "packages/shared/src/core/usages/find-usages.ts": ["exports", "types"],
    "packages/shared/src/utils/styleguide/check-compliance.ts": ["exports", "types"],
    "packages/shared/src/utils/styleguide/localization-guidance.ts": ["exports", "types"]
  },
  "ignore": [
    "apps/web/**",
    "apps/extension/src/lucide-icons.ts", // auto-generated, all icons kept for lookup
    "apps/extension/src/tests/test-projects/**", // fixtures read via fs paths, not imports
    "apps/extension/.vscode-test.mjs" // vscode-test config file, no knip plugin for it
  ],
  "workspaces": {
    ".": {},
    "apps/lint": {},
    "packages/shared": {},
    "packages/types": {},
    "packages/node-platform": {},
    "apps/extension": {
      "entry": [
        "src/tests/**/*.test.ts" // mocha via vscode-test, not vitest
      ],
      "ignoreDependencies": [
        "lucide-static", // consumed via fs path in tools/build-icons.js, not import
        "@vscode/test-electron" // transitive dep of @vscode/test-cli, pinned explicitly
      ],
      "ignoreBinaries": [
        "vsce" // npx-invoked in publish scripts only
      ]
    }
  }
}

async function createResourceManager(platform, module2) {
  const { files: matchedFiles, defaultNs } = await resolveModuleTranslations(platform, module2);
  if (!matchedFiles.length) {
    return null;
  }
  const files = await Promise.all(
    matchedFiles.map(async (relativePath) => ({
      relativePath,
      content: await platform.readFile(relativePath)
    }))
  );
  return new ResourceManager(
    {
      layout: module2.translations.layout,
      defaultNs,
      sortKeys: module2.translations.sortKeys,
      i18nFramework: module2.framework,
      globPattern: module2.translations.glob
    },
    files
  );
}
function stringifyAndClean(obj, removeBrackets = false, removeSemicolons = false) {
  const stringified = JSON.stringify(obj);
  let cleaned = stringified.replace(/\{"/g, "{").replace(/,"/g, ", ").replace(/":/g, removeSemicolons ? " " : ": ");
  if (removeBrackets) {
    cleaned = cleaned.slice(1, -1);
  }
  return cleaned;
}

// src/context.ts
function fail(...lines) {
  console.error(lines.join("\n"));
  process.exit(1);
}
function loadPlatform() {
  return createNodePlatform(process.cwd());
}
function failConfigError(err) {
  if (err instanceof LoccyConfigError) return fail(err.message);
  return fail(`${loccyConfigFilename} could not be read: ${err instanceof Error ? err.message : String(err)}`);
}
async function loadConfig(platform = loadPlatform()) {
  let config;
  try {
    config = await readConfigFile(platform);
  } catch (err) {
    return failConfigError(err);
  }
  if (!config) {
    return fail(
      `No ${loccyConfigFilename}, so there is nothing to read this project's i18n setup from.`,
      `Scaffold it first: loccy-tool init`
    );
  }
  return config;
}
function selectModule(config, moduleName) {
  const names = Object.keys(config.modules);
  if (!moduleName) {
    if (names.length > 1) {
      fail(
        `This project has ${names.length} i18n modules: ${names.join(", ")}`,
        `  name the one you mean with --module, e.g. --module ${names[0]}`
      );
    }
    return config.modules[names[0]];
  }
  const module2 = config.modules[moduleName];
  if (!module2) fail(`Module "${moduleName}" not found. Available: ${names.join(", ")}`);
  return module2;
}
async function loadModuleContext(options) {
  const platform = loadPlatform();
  const config = await loadConfig(platform);
  const module2 = selectModule(config, options.module);
  const rm2 = await createResourceManager(platform, module2);
  if (!rm2) {
    fail(`No translation files matched ${module2.translations.glob}. Check translations.glob in ${loccyConfigFilename}`);
  }
  return { platform, config, module: module2, rm: rm2 };
}
function failOnNamespacedKey(keypath) {
  if (!keypath.includes(":")) return;
  fail(`"${keypath}" spells a namespace into the key.`, "  a key is always a bare keypath; the namespace goes in --ns");
}
function requireKeypath(keypath) {
  failOnNamespacedKey(keypath);
  if (!keypath.trim()) fail("a key cannot be empty. Write it as segments, e.g. login.title");
  if (keypath.split(".").some((segment) => !segment.trim())) {
    fail(`"${keypath}" has an empty segment. Write dot-separated segments with no blanks, e.g. login.title`);
  }
  return keypath;
}
function realNamespaces(ctx) {
  return ctx.rm.namespaces.filter((ns) => ns !== NS_WITHOUT_NS);
}
function resolveNamespace(ctx, options = {}) {
  const namespaces = realNamespaces(ctx);
  if (!namespaces.length) {
    if (options.ns) fail(`This project has no namespaces, so --ns "${options.ns}" names nothing.`);
    return ctx.rm.defaultNs;
  }
  if (!options.ns) {
    if (namespaces.length === 1) return namespaces[0];
    return fail(
      `This project has ${namespaces.length} namespaces: ${namespaces.join(", ")}`,
      `  name the one you mean with --ns, e.g. --ns ${namespaces[0]}`
    );
  }
  if (!namespaces.includes(options.ns)) {
    fail(`Namespace "${options.ns}" not found. Available: ${namespaces.join(", ")}`);
  }
  return options.ns;
}
function requireLocale(ctx, locale) {
  if (!ctx.rm.allLocales.includes(locale)) {
    fail(`Locale "${locale}" not detected. Available: ${ctx.rm.allLocales.join(", ")}`);
  }
  return locale;
}
function requireCount(raw, flag, fallback) {
  if (raw === void 0) return fallback;
  const value = Number(raw);
  if (!Number.isInteger(value) || value < 1) fail(`${flag} must be a whole number of 1 or more, got "${raw}"`);
  return value;
}
function truncationLine(total, limit, flag) {
  if (total <= limit) return null;
  return `... ${total - limit} more (${total} total)${flag ? `, raise ${flag}` : ""}`;
}

// src/commands/init.ts
async function initCommand() {
  const platform = loadPlatform();
  if (await platform.exists(loccyConfigFilename)) {
    fail(
      `${loccyConfigFilename} already exists. Edit it directly, against the field reference at
${LOCCY_SCHEMA_URL}. The session briefing shows what the file resolves to.`
    );
  }
  const { usedPlaceholder } = await initializeConfigFiles(platform);
  console.log(`created ${loccyConfigFilename}`);
  console.log(
    usedPlaceholder ? `
Nothing could be auto-detected, so it holds placeholders. Fill in the default module
(framework, usages.include, translations.glob) before running anything else.` : `
It was written from auto-detection, which guesses. Check every field against the real repo:
framework, source globs, translation glob, layout, locales. Then author the styleguide.`
  );
}

// src/stdin.ts
var READ_TIMEOUT_MS = 5e3;
function readStdin() {
  if (process.stdin.isTTY) return Promise.resolve("");
  return new Promise((resolve2, reject) => {
    let data = "";
    const finish = () => {
      clearTimeout(timer);
      process.stdin.pause();
      recordStdin(data);
      resolve2(data);
    };
    const timer = setTimeout(finish, READ_TIMEOUT_MS);
    process.stdin.setEncoding("utf-8");
    process.stdin.on("data", (chunk) => data += chunk);
    process.stdin.on("end", finish);
    process.stdin.on("error", (err) => {
      clearTimeout(timer);
      reject(err);
    });
  });
}

// src/commands/search.ts
function compile(query, what) {
  try {
    return new RegExp(query, "i");
  } catch (err) {
    return fail(`error: ${what} is not a valid regular expression: ${err instanceof Error ? err.message : err}`);
  }
}
function matcherFor(query, what) {
  const pattern2 = compile(query, what);
  return (haystack) => pattern2.test(haystack);
}
function matchesFor({ ctx, namespaces, locales, key }, text) {
  const matched = [];
  for (const ns of namespaces) {
    const flatPerLocale = ctx.rm.getFlatTranslationsPerLocale(ns);
    const seen = /* @__PURE__ */ new Set();
    for (const locale of locales) {
      for (const [keypath, value] of Object.entries(flatPerLocale[locale] ?? {})) {
        if (seen.has(keypath)) continue;
        if (key && !key(keypath)) continue;
        if (text && !text(value)) continue;
        seen.add(keypath);
        matched.push({ ns, keypath });
      }
    }
  }
  return matched.sort((a, b) => qualifyKey(a.ns, a.keypath).localeCompare(qualifyKey(b.ns, b.keypath)));
}
function valuesOf({ ctx, locales, inheriting }, { ns, keypath }) {
  const flatPerLocale = ctx.rm.getFlatTranslationsPerLocale(ns);
  const values = {};
  for (const locale of locales) {
    const value = flatPerLocale[locale]?.[keypath];
    if (value !== void 0) values[locale] = value;
    else if (!inheriting.has(locale)) values[locale] = "";
  }
  return values;
}
function printMatches(search, label, matched) {
  const { locales, narrowed, limit } = search;
  if (!matched.length) return void console.log(`No matches for ${label}`);
  const where = narrowed ? ` in ${locales.join(", ")}` : "";
  console.log(`${matched.length} match${s(matched.length, "es")} for ${label}${where}
`);
  for (const match of matched.slice(0, limit ?? matched.length)) {
    console.log(`keypath: ${qualifyKey(match.ns, match.keypath)}`);
    console.log("locales:");
    for (const [locale, value] of Object.entries(valuesOf(search, match))) {
      console.log(`  ${locale}: ${value || "(missing)"}`);
    }
    console.log("");
  }
  const truncated = limit === null ? null : truncationLine(matched.length, limit, "--limit");
  if (truncated) console.log(truncated);
}
function labelFor(keyQuery, text) {
  return [text && `"${text}"`, keyQuery && `keys matching "${keyQuery}"`].filter(Boolean).join(" and ");
}
function printJson(search, blocks) {
  console.log(
    JSON.stringify(
      {
        locales: search.locales,
        results: blocks.map(({ text, key, matched }) => ({
          text: text ?? null,
          key: key ?? null,
          total: matched.length,
          matches: matched.slice(0, search.limit ?? matched.length).map((match) => ({
            ns: match.ns === NS_WITHOUT_NS ? null : match.ns,
            keypath: match.keypath,
            values: valuesOf(search, match)
          }))
        }))
      },
      null,
      2
    )
  );
}
async function keySetMatcher() {
  const keys2 = new Set(
    (await readStdin()).split("\n").map((line) => line.trim()).filter(Boolean)
  );
  if (!keys2.size) fail("error: --key - got nothing on stdin", "  pipe the keypaths in, one per line");
  keys2.forEach(failOnNamespacedKey);
  return (keypath) => keys2.has(keypath);
}
async function searchCommand(queries, options) {
  const ctx = await loadModuleContext(options);
  const namespaces = ctx.rm.namespaces.filter((ns) => ns !== NS_WITHOUT_NS);
  if (options.ns && !namespaces.includes(options.ns)) {
    fail(`Namespace "${options.ns}" not found. Available: ${namespaces.join(", ") || "none"}`);
  }
  if (!queries.length && !options.key) {
    fail("error: nothing to search for", "  pass text to match, or --key <pattern> to match the keypath, or both");
  }
  const fromStdin = options.key === "-";
  if (options.key && !fromStdin) failOnNamespacedKey(options.key);
  const search = {
    ctx,
    // Every namespace by default: a match hiding in a namespace nobody named is the whole problem.
    namespaces: options.ns ? [options.ns] : ctx.rm.namespaces,
    locales: options.locale ? [requireLocale(ctx, options.locale)] : ctx.rm.allLocales,
    narrowed: Boolean(options.locale),
    inheriting: new Set(partialOverridesOf(ctx.config.styleguide?.localeRules).map((override) => override.locale)),
    key: fromStdin ? await keySetMatcher() : options.key ? matcherFor(options.key, `--key "${options.key}"`) : null,
    limit: options.limit === void 0 ? null : requireCount(options.limit, "--limit", 0)
  };
  const texts = queries.length ? queries : [void 0];
  const blocks = texts.map((text) => ({
    text,
    key: fromStdin ? "the keys on stdin" : options.key,
    matched: matchesFor(search, text === void 0 ? null : matcherFor(text, `"${text}"`))
  }));
  if (options.json) return printJson(search, blocks);
  blocks.forEach(({ text, key, matched }, index) => {
    if (index) console.log("");
    printMatches(search, labelFor(key, text), matched);
  });
}

// ../../packages/shared/src/core/loccy-config/regional-override-guards.ts
function primaryLocales(allLocales, styleguide) {
  const overrides = new Set(partialOverridesOf(styleguide?.localeRules).map((o) => o.locale));
  return allLocales.filter((locale) => !overrides.has(locale));
}
function findMissingPrimaryLocales(values, allLocales, styleguide) {
  return primaryLocales(allLocales, styleguide).filter((locale) => !(locale in values));
}
function findRedundantOverrides(values, styleguide, storedValueFor = () => void 0) {
  const redundant = [];
  for (const override of partialOverridesOf(styleguide?.localeRules)) {
    const value = values[override.locale]?.trim();
    if (!value) continue;
    const parentValue = (values[override.extends] ?? storedValueFor(override.extends))?.trim();
    if (parentValue && value === parentValue) {
      redundant.push({ locale: override.locale, extends: override.extends, value });
    }
  }
  return redundant;
}

// ../../packages/shared/src/utils/styleguide/check-compliance.ts
function contains(haystack, needle, caseSensitive) {
  return caseSensitive ? haystack.includes(needle) : haystack.toLowerCase().includes(needle.toLowerCase());
}
function written(values) {
  return Object.entries(values).filter(([, value]) => value.trim());
}
function localeTerm(terms, locale) {
  return terms[locale] ?? terms[locale.split("-")[0]];
}
function checkDoNotTranslate(values, styleguide) {
  const issues = [];
  const entries = written(values);
  for (const term of styleguide?.doNotTranslate ?? []) {
    const caseSensitive = term.caseSensitive ?? false;
    const holders = entries.filter(([, value]) => contains(value, term.term, caseSensitive));
    if (!holders.length) continue;
    for (const [locale, value] of entries) {
      if (contains(value, term.term, caseSensitive)) continue;
      issues.push({
        locale,
        message: `"${term.term}" must stay verbatim, and the ${locale} value drops it (${holders.map(([code]) => code).join(", ")} keep${holders.length === 1 ? "s" : ""} it)`
      });
    }
  }
  return issues;
}
function checkGlossary(values, styleguide) {
  const issues = [];
  const entries = written(values);
  for (const entry of styleguide?.glossary ?? []) {
    const forms = new Map(entries.map(([locale]) => [locale, localeTerm(entry.terms, locale)]));
    for (const [locale, value] of entries) {
      for (const deprecated of deprecatedForms(forms.get(locale) ?? "")) {
        if (contains(value, deprecated, false)) {
          issues.push({
            locale,
            message: `"${deprecated}" is deprecated for ${entry.definition}, use "${preferredForm(forms.get(locale))}"`
          });
        }
      }
    }
    const inPlay = entries.some(([locale, value]) => {
      const preferred = preferredForm(forms.get(locale) ?? "");
      return preferred && contains(value, preferred, false);
    });
    if (!inPlay) continue;
    for (const [locale, value] of entries) {
      const preferred = preferredForm(forms.get(locale) ?? "");
      if (!preferred || contains(value, preferred, false)) continue;
      issues.push({ locale, message: `${entry.definition}: the ${locale} value should use "${preferred}"` });
    }
  }
  return issues;
}

// src/file-list.ts
function commonDir(files) {
  if (files.length < 2) return "";
  const segments = files.map((file) => file.split("/").slice(0, -1));
  const shared = [];
  for (let depth = 0; depth < Math.min(...segments.map((parts) => parts.length)); depth++) {
    const segment = segments[0][depth];
    if (!segments.every((parts) => parts[depth] === segment)) break;
    shared.push(segment);
  }
  return shared.length ? `${shared.join("/")}/` : "";
}
function collapsePaths(files, max = Infinity) {
  const dir = commonDir(files);
  const listed = files.slice(0, max).map((file) => file.slice(dir.length));
  const rest = files.length - listed.length;
  const names = `${listed.join(", ")}${rest > 0 ? `, +${rest} more` : ""}`;
  return dir ? `${dir}{${names}}` : names;
}

// src/keypath-guards.ts
var SHOWN_DESCENDANTS = 5;
function failOnStructuralCollision(ctx, ns, keypaths, vacated = []) {
  const existing = Object.keys(ctx.rm.getFlatTranslationsPerKeypath(ns)).filter((keypath) => !vacated.includes(keypath));
  for (const keypath of keypaths) {
    const siblings = keypaths.filter((other) => other !== keypath);
    const tree = [...existing, ...siblings];
    const descendants = [...new Set(tree.filter((other) => other.startsWith(`${keypath}.`)))];
    if (descendants.length) {
      fail(
        `error: "${qualifyKey(ns, keypath)}" is a group of ${descendants.length} message(s), not a message`,
        ...descendants.slice(0, SHOWN_DESCENDANTS).map((d) => `  ${qualifyKey(ns, d)}`),
        ...descendants.length > SHOWN_DESCENDANTS ? [`  ... ${descendants.length - SHOWN_DESCENDANTS} more`] : [],
        "  writing here would delete every one of them, so pick a keypath below this one instead"
      );
    }
    const ancestor = tree.find((other) => keypath.startsWith(`${other}.`));
    if (ancestor) {
      fail(
        `error: "${qualifyKey(ns, ancestor)}" is already a message, so nothing can nest under it`,
        `  rename it out of the way first, or pick a keypath that is not below it`
      );
    }
  }
}

// src/styleguide-output.ts
import { createHash } from "node:crypto";

// ../../packages/shared/src/utils/styleguide/styleguide-prompt.ts
function buildDoNotTranslateMarkdown(doNotTranslate) {
  return doNotTranslate.map((entry) => {
    const caseNote = entry.caseSensitive ? " (case-sensitive \u2014 preserve exact casing)" : "";
    const definition = entry.definition ? ` \u2014 ${entry.definition}` : "";
    return `- "${entry.term}" stays verbatim${caseNote}${definition}`;
  }).join("\n");
}
function buildGlossaryMarkdown(glossary, targetLocales, sourceLocale) {
  const lines = [];
  const locales = sourceLocale ? [sourceLocale, ...targetLocales.filter((l) => l !== sourceLocale)] : targetLocales;
  for (const entry of glossary) {
    const perLocale = locales.map((loc) => {
      const localeValue = entry.terms[loc] ?? entry.terms[loc.split("-")[0]];
      if (!localeValue) return null;
      const preferred = preferredForm(localeValue);
      if (!preferred) return null;
      const deprecated = deprecatedForms(localeValue);
      const deprecatedNote = deprecated.length ? `, never: ${deprecated.join(", ")}` : "";
      const sourceNote = loc === sourceLocale ? " (source)" : "";
      return `${loc} \u2192 ${preferred}${sourceNote}${deprecatedNote}`;
    }).filter(Boolean);
    if (!perLocale.length) continue;
    lines.push(`- ${entry.definition}: ${perLocale.join("; ")}`);
  }
  return lines.join("\n");
}
function localeProse(bundle, locale) {
  const localeRules = bundle.styleguide?.localeRules;
  const value = localeRules?.[locale] ?? localeRules?.[locale.split("-")[0]];
  return typeof value === "string" ? value.trim() : "";
}
function buildStyleguidePrompt(bundle, targetLocales, sourceLocale) {
  const sections = [];
  const styleguide = bundle.styleguide;
  if (styleguide?.product?.trim()) sections.push(`## product
${styleguide.product.trim()}`);
  if (styleguide?.voice?.trim()) sections.push(`## voice
${styleguide.voice.trim()}`);
  if (styleguide?.mechanics?.trim()) sections.push(`## mechanics
${styleguide.mechanics.trim()}`);
  for (const locale of targetLocales) {
    const prose = localeProse(bundle, locale);
    if (prose) sections.push(`## localeRules.${locale}
${prose}`);
  }
  const doNotTranslate = buildDoNotTranslateMarkdown(bundle.styleguide?.doNotTranslate ?? []);
  if (doNotTranslate) sections.push(`## doNotTranslate
${doNotTranslate}`);
  const glossary = buildGlossaryMarkdown(bundle.styleguide?.glossary ?? [], targetLocales, sourceLocale);
  if (glossary) sections.push(`## glossary
${glossary}`);
  return sections.join("\n\n");
}

// ../../packages/shared/src/utils/styleguide/localization-guidance.ts
function overrideParentFor(styleguide, locale, visibleLocales) {
  const override = partialOverridesOf(styleguide?.localeRules).find((o) => o.locale === locale);
  if (!override) return null;
  return visibleLocales.includes(override.extends) ? override.extends : null;
}
function buildRegionalOverrideSpecs(styleguide, targetLocales, contextLocales) {
  const overrides = partialOverridesOf(styleguide?.localeRules);
  if (!overrides.length) return [];
  const visible = [.../* @__PURE__ */ new Set([...targetLocales, ...contextLocales])];
  const specs = [];
  for (const locale of targetLocales) {
    const extendsLocale = overrideParentFor(styleguide, locale, visible);
    if (!extendsLocale) continue;
    const rule = overrides.find((o) => o.locale === locale)?.style ?? "";
    const parentStyle = localeProse({ styleguide }, extendsLocale);
    specs.push({ locale, extends: extendsLocale, rule, parentStyle });
  }
  return specs;
}
function resolveLocalizationGuidance(styleguide, targetLocales, contextLocales = []) {
  const regionalOverrides = buildRegionalOverrideSpecs(styleguide, targetLocales, contextLocales);
  const overrideLocales = new Set(regionalOverrides.map((s2) => s2.locale));
  const baseLocales = targetLocales.filter((l) => !overrideLocales.has(l));
  const styleguideText = buildStyleguidePrompt({ styleguide }, baseLocales, contextLocales[0]);
  return {
    styleguideText: styleguideText || void 0,
    regionalOverrides: regionalOverrides.length ? regionalOverrides : void 0
  };
}

// src/styleguide-output.ts
function hasStyleguideRules(config) {
  const styleguide = config.styleguide;
  return Boolean(
    styleguide?.keys?.trim() || styleguide?.product?.trim() || styleguide?.voice?.trim() || styleguide?.mechanics?.trim() || styleguide?.localeRules || styleguide?.doNotTranslate?.length || styleguide?.glossary?.length
  );
}
function droppedStyleguideNote(config) {
  const dropped = config.droppedStyleguideFields;
  if (!dropped?.length) return null;
  return [
    "## Styleguide fields ignored",
    "",
    `${loccyConfigFilename} spells these in a shape the schema cannot take, so they were dropped and`,
    "nothing is checked against them. Tell the user, and offer to fix them:",
    "",
    ...dropped.map(({ field, reason }) => `  ${field}: ${reason}`)
  ].join("\n");
}
var EMPTY_STYLEGUIDE_NOTE = "The styleguide is empty, so nothing here constrains the copy. The author-styleguide skill covers filling it in.";
var NO_KEY_GUIDELINES = "None. Follow the key naming the corpus already uses (`loccy-tool search`).";
function printWritingRules(config, targetLocales) {
  const parents = partialOverridesOf(config.styleguide?.localeRules).filter((override) => targetLocales.includes(override.locale)).map((override) => override.extends);
  const { styleguideText, regionalOverrides } = resolveLocalizationGuidance(config.styleguide, targetLocales, parents);
  if (styleguideText) console.log(styleguideText);
  for (const override of regionalOverrides ?? []) {
    console.log(`
## localeRules.${override.locale} (extends ${override.extends})`);
    console.log(override.rule.trim() || `no documented deviation from ${override.extends}`);
    if (override.parentStyle) console.log(`
${override.extends} style: ${override.parentStyle}`);
  }
  if (!styleguideText && !regionalOverrides?.length) console.log(EMPTY_STYLEGUIDE_NOTE);
}
function printInheritedOverrides(config, allLocales, targetLocales) {
  const omitted = partialOverridesOf(config.styleguide?.localeRules).filter(
    (override) => allLocales.includes(override.locale) && !targetLocales.includes(override.locale)
  );
  if (!omitted.length) return;
  console.log("\n## Partial-override locales not in view");
  console.log("Each inherits its parent unless the text genuinely deviates. Include one only in that case.");
  for (const override of omitted) {
    const parentProse = localeProse({ styleguide: config.styleguide }, override.extends);
    console.log(`
### localeRules.${override.locale} extends ${override.extends}`);
    console.log(
      `deviates only where: ${override.style?.trim() || "no rule documented, so treat any deviation as suspect"}`
    );
    if (parentProse) console.log(`${override.extends} style: ${parentProse}`);
  }
}
function printStyleguide(config, allLocales, targetLocales) {
  console.log("## keys\n");
  console.log(config.styleguide?.keys?.trim() || NO_KEY_GUIDELINES);
  console.log("");
  printWritingRules(config, targetLocales);
  printInheritedOverrides(config, allLocales, targetLocales);
}
function stableStringify(value) {
  if (Array.isArray(value)) return `[${value.map(stableStringify).join(",")}]`;
  if (value && typeof value === "object") {
    const entries = Object.entries(value).filter(([, entry]) => entry !== void 0).sort(([a], [b]) => a.localeCompare(b));
    return `{${entries.map(([key, entry]) => `${JSON.stringify(key)}:${stableStringify(entry)}`).join(",")}}`;
  }
  return JSON.stringify(value) ?? "null";
}
function styleguideToken(config) {
  return createHash("sha256").update(stableStringify(config.styleguide ?? {})).digest("hex").slice(0, 8);
}
function styleguidedFlag(config) {
  return `--styleguided ${styleguideToken(config)}`;
}
function printHandshake(howToRun, note) {
  console.log(`
## Writing against these rules

${howToRun}
`);
  console.log("The token above says these rules were read. It is derived from them, not issued per write, so the");
  console.log(
    "same token confirms every write until the rules change. Once you read the full styleguide, pass it always."
  );
  if (note) console.log(note);
}

// src/write.ts
async function snapshot(platform, paths) {
  const before = /* @__PURE__ */ new Map();
  for (const path5 of paths) {
    before.set(path5, await platform.exists(path5) ? await platform.readFile(path5) : null);
  }
  return before;
}
async function restore(platform, before, written2) {
  const failures = [];
  for (const path5 of written2) {
    const original = before.get(path5);
    try {
      if (original === null) await platform.deleteFile(path5);
      else if (original !== void 0) await platform.writeFile(path5, original);
    } catch {
      failures.push(path5);
    }
  }
  return failures;
}
async function writeAllOrNothing(platform, changed) {
  if (!changed.size) {
    throw new Error("The batch resolved to no translation file, so nothing was written. Check --module and --ns.");
  }
  const before = await snapshot(platform, changed.keys());
  const written2 = [];
  try {
    for (const [path5, content] of changed) {
      await platform.writeFile(path5, content);
      written2.push(path5);
    }
  } catch (err) {
    const failures = await restore(platform, before, written2);
    const reason = err instanceof Error ? err.message : String(err);
    throw new Error(
      failures.length ? `${reason}
Rolled the batch back, except: ${collapsePaths(failures)}. Check those files by hand.` : `${reason}
Nothing was written: the batch was rolled back.`
    );
  }
}

// src/commands/upsert-message.ts
function parseValues(ctx, key, raw) {
  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
    fail(`error: ${key} must map to a JSON object of { locale: value }`);
  }
  const values = {};
  for (const [locale, value] of Object.entries(raw)) {
    if (typeof value !== "string") fail(`error: ${key}: value for locale "${locale}" must be a string`);
    if (!ctx.rm.allLocales.includes(locale)) {
      fail(
        `error: ${key}: locale "${locale}" is not one of this project's: ${ctx.rm.allLocales.join(", ")}`,
        `  adding a locale means adding its translation files and declaring it in ${loccyConfigFilename}, not writing one message at it`
      );
    }
    values[locale] = value;
  }
  return values;
}
function parseJson(raw) {
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    return fail(`error: invalid JSON on stdin:`, raw);
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
    return fail("error: expected a JSON object on stdin");
  }
  return parsed;
}
function parseEntries(ctx, raw, options) {
  const parsed = parseJson(raw);
  if (!Object.keys(parsed).length) fail("error: the batch on stdin is empty");
  const ns = resolveNamespace(ctx, options);
  const entries = Object.entries(parsed).map(([entryKey, values]) => ({
    ns,
    keypath: requireKeypath(entryKey),
    values: parseValues(ctx, entryKey, values)
  }));
  return { ns, entries };
}
function deletedLocales(values) {
  return Object.entries(values).filter(([, value]) => !value.trim()).map(([locale]) => locale);
}
function enforceGuards(ctx, entries) {
  const styleguide = ctx.config.styleguide;
  const problems = [];
  for (const { ns, keypath, values } of entries) {
    const key = qualifyKey(ns, keypath);
    const stored = (locale) => ctx.rm.getFlatTranslationsPerLocale(ns)[locale]?.[keypath];
    const missing = findMissingPrimaryLocales(values, ctx.rm.allLocales, styleguide);
    if (missing.length) {
      problems.push(
        `error: ${key} says nothing about primary locale(s): ${missing.join(", ")}`,
        `  this key needs all of: ${primaryLocales(ctx.rm.allLocales, styleguide).join(", ")}, and upsert-message writes exactly the locales you pass`,
        '  give each one text, or "" to delete the key from that locale'
      );
    }
    for (const { locale, extends: parent, value } of findRedundantOverrides(values, styleguide, stored)) {
      problems.push(
        `error: ${key}: ${locale} is a partial override of ${parent} and repeats it: "${value}"`,
        `  a partial-override locale carries its own value only where the text deviates; everywhere else it inherits at runtime, so a copy here is dead weight that goes stale the day the parent changes`,
        `  drop ${locale} from the JSON`
      );
    }
  }
  if (problems.length) fail(...problems);
}
function printAdvisories(ctx, entries) {
  const styleguide = ctx.config.styleguide;
  for (const { ns, keypath, values } of entries) {
    const key = qualifyKey(ns, keypath);
    printIssues(key, "do-not-translate", checkDoNotTranslate(values, styleguide));
    printIssues(key, "glossary", checkGlossary(values, styleguide));
  }
}
function printIssues(key, check, issues) {
  if (!issues.length) return;
  console.log(`warning: ${key}: automated ${check} check triggered. Fix unless it is a false positive.`);
  for (const issue of issues) console.log(`  ${issue.message}`);
}
function printStyleguideReview(ctx, entries) {
  for (const entry of entries) {
    const deleted = deletedLocales(entry.values);
    if (deleted.length) {
      console.log(
        `Note: "" for ${deleted.join(", ")} deletes ${qualifyKey(entry.ns, entry.keypath)} from those locale files.`
      );
    }
  }
  console.log("\n  loccy-tool styleguide");
  console.log("\nThat prints the rules this project writes by, and the token. Check the values against them,");
  console.log("then rerun with --styleguided <token>.");
}
function printTemplate(ctx) {
  const required = primaryLocales(ctx.rm.allLocales, ctx.config.styleguide);
  const skeleton = Object.fromEntries(required.map((locale) => [locale, ""]));
  console.log(`upsert-message needs every primary locale of "${ctx.module.name}" in one call, as JSON on stdin:
`);
  console.log(`  ${JSON.stringify({ "login.title": skeleton })}
`);
  console.log('Text writes the value. "" deletes the key from that locale file, which is how one locale');
  console.log("drops back to its fallback while the others keep the key.\n");
  printStyleguide(ctx.config, ctx.rm.allLocales, required);
  const batch = JSON.stringify({ "login.title": skeleton, "login.subtitle": skeleton });
  printHandshake(`  loccy-tool upsert-message ${styleguidedFlag(ctx.config)} <<'EOF'
  ${batch}
  EOF`);
}
async function upsertMessageCommand(options) {
  const raw = await readStdin();
  const ctx = await loadModuleContext(options);
  if (!raw.trim()) {
    printTemplate(ctx);
    return;
  }
  const { ns, entries } = parseEntries(ctx, raw, options);
  failOnStructuralCollision(
    ctx,
    ns,
    entries.map((entry) => entry.keypath)
  );
  enforceGuards(ctx, entries);
  printAdvisories(ctx, entries);
  if (hasStyleguideRules(ctx.config) && !confirmed(ctx, entries, options.styleguided)) return;
  await applyEntries(ctx, entries);
}
function confirmed(ctx, entries, token5) {
  const expected = styleguideToken(ctx.config);
  if (token5 === expected) return true;
  if (token5) {
    console.log(`
[nothing written yet] token ${token5} does not match this project's styleguide as it stands.`);
    console.log("Either the rules changed since it was issued, or it came from somewhere else.");
  } else {
    console.log("\n[nothing written yet] this call carries no --styleguided token.");
  }
  printStyleguideReview(ctx, entries);
  return false;
}
async function applyEntries(ctx, entries) {
  const before = new Map(
    entries.map((entry) => [
      qualifyKey(entry.ns, entry.keypath),
      ctx.rm.existingTranslationsLocalizedText(entry.keypath, entry.ns)
    ])
  );
  const changed = /* @__PURE__ */ new Map();
  for (const ns of new Set(entries.map((entry) => entry.ns))) {
    const perKeypath = Object.fromEntries(
      entries.filter((entry) => entry.ns === ns).map((entry) => [entry.keypath, entry.values])
    );
    for (const [filePath, content] of ctx.rm.updateKeypaths(perKeypath, ns)) changed.set(filePath, content);
  }
  if (!changed.size) {
    console.log(`no change: the files already say exactly this for ${entries.length} key${s(entries.length)}`);
    return;
  }
  await writeAllOrNothing(ctx.platform, changed);
  console.log(`wrote ${entries.length} key${s(entries.length)} to ${collapsePaths([...changed.keys()])}`);
  printStaleNameReminder(entries, before);
}
function printStaleNameReminder(entries, before) {
  const reworded = entries.some(
    (entry) => Object.entries(entry.values).some(([locale, value]) => {
      const previous = before.get(qualifyKey(entry.ns, entry.keypath))?.[locale]?.trim();
      return previous && value.trim() && previous !== value.trim();
    })
  );
  if (!reworded) return;
  console.log("  hint: copy changed, so a keypath may no longer describe its message. rename-key the ones that drifted");
}

// src/commands/remove-message.ts
async function removeMessageCommand(keys2, options) {
  const ctx = await loadModuleContext(options);
  const ns = resolveNamespace(ctx, options);
  const resolved = keys2.map((key) => ({ ns, keypath: requireKeypath(key) }));
  const missing = resolved.filter(
    ({ ns: ns2, keypath }) => !Object.values(ctx.rm.getFlatTranslationsPerLocale(ns2)).some((flat) => keypath in flat)
  );
  if (missing.length) {
    fail(`error: not found: ${missing.map(({ ns: ns2, keypath }) => qualifyKey(ns2, keypath)).join(", ")}`);
  }
  const changed = /* @__PURE__ */ new Map();
  for (const { ns: ns2, keypath } of resolved) {
    const cleared = {};
    for (const [locale, flat] of Object.entries(ctx.rm.getFlatTranslationsPerLocale(ns2))) {
      if (keypath in flat) cleared[locale] = "";
    }
    for (const [filePath, content] of ctx.rm.updateValue(keypath, cleared, ns2)) changed.set(filePath, content);
  }
  await writeAllOrNothing(ctx.platform, changed);
  console.log(`removed: ${resolved.map(({ ns: ns2, keypath }) => qualifyKey(ns2, keypath)).join(", ")}`);
  console.log(`files: ${collapsePaths([...changed.keys()])}`);
}

// ../../packages/shared/src/core/resources/linked-refs.ts
function rewriteLinkedRefs(content, oldKeypath, newKeypath, framework, targetNs) {
  const utils = getFramework(framework)?.ideInsert?.linkedMessageUtils;
  if (!utils) {
    return content;
  }
  const search = utils.build(oldKeypath, targetNs);
  if (!content.includes(search)) {
    return content;
  }
  const regex2 = new RegExp(utils.regex.source, utils.regex.flags);
  return content.replace(regex2, (match, ref) => {
    const { keypath: refKeypath, ns: refNs } = utils.parse(ref);
    if (refKeypath === oldKeypath && refNs === targetNs) {
      return match.replace(oldKeypath, newKeypath);
    }
    return match;
  });
}
function rewriteLinkedRefsInContents(contents, localeMap, framework, oldKeypath, newKeypath, ns) {
  const changed = /* @__PURE__ */ new Map();
  if (!getFramework(framework)?.ideInsert?.linkedMessageUtils) {
    return changed;
  }
  for (const [relativePath, content] of contents) {
    const fileNs = localeMap.get(relativePath)?.namespace;
    const targetNs = fileNs === ns ? void 0 : ns;
    const next = rewriteLinkedRefs(content, oldKeypath, newKeypath, framework, targetNs);
    if (next !== content) {
      changed.set(relativePath, next);
    }
  }
  return changed;
}

// src/commands/rename-key.ts
function parseRenames(ctx, raw, options) {
  if (!raw.trim()) {
    fail(
      "error: nothing to rename",
      `  loccy-tool rename-key <<'EOF'`,
      '  {"login.title":"login.heading","login.ok":"login.confirm"}',
      "  EOF"
    );
  }
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    fail("error: invalid JSON on stdin:", raw);
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
    fail('error: expected a JSON object of { "old.key": "new.key" } on stdin');
  }
  const entries = Object.entries(parsed);
  if (!entries.length) fail("error: the batch on stdin is empty");
  const ns = resolveNamespace(ctx, options);
  const renames = entries.map(([from, to]) => {
    if (typeof to !== "string") fail(`error: ${from} must map to the new key as a string`);
    return toRename(ctx, ns, from, to);
  });
  return { ns, renames };
}
function toRename(ctx, ns, oldKey, newKey) {
  const from = requireKeypath(oldKey);
  const to = requireKeypath(newKey);
  if (!Object.values(ctx.rm.getFlatTranslationsPerLocale(ns)).some((flat) => from in flat)) {
    fail(`error: "${from}" not found in namespace "${ns}"`);
  }
  return { ns, from, to };
}
function failOnOccupiedTargets(ctx, renames) {
  const problems = [];
  for (const { ns, from, to } of renames) {
    const occupied = Object.values(ctx.rm.getFlatTranslationsPerLocale(ns)).some((flat) => to in flat);
    if (occupied) {
      problems.push(
        `error: ${qualifyKey(ns, to)} already exists, so renaming ${qualifyKey(ns, from)} onto it would drop one of the two`,
        `  pick a free key, or merge them deliberately: upsert-message ${qualifyKey(ns, to)}, then remove-message ${qualifyKey(ns, from)}`
      );
    }
  }
  const targets = renames.map(({ ns, to }) => qualifyKey(ns, to));
  const collided = [...new Set(targets.filter((target, index) => targets.indexOf(target) !== index))];
  if (collided.length) {
    problems.push(`error: this batch renames more than one key onto: ${collided.join(", ")}`);
  }
  if (problems.length) fail(...problems);
}
async function renameKeyCommand(options) {
  const raw = await readStdin();
  const ctx = await loadModuleContext(options);
  const { ns, renames } = parseRenames(ctx, raw, options);
  failOnOccupiedTargets(ctx, renames);
  failOnStructuralCollision(
    ctx,
    ns,
    renames.map(({ to }) => to),
    renames.map(({ from }) => from)
  );
  const changed = /* @__PURE__ */ new Map();
  for (const { from, to } of renames) {
    for (const [filePath, content] of ctx.rm.renameKeypath(from, to, ns)) changed.set(filePath, content);
  }
  const linked = /* @__PURE__ */ new Map();
  for (const { from, to } of renames) {
    const contents = new Map([...ctx.rm.getAllFileContents(), ...linked]);
    for (const [filePath, content] of rewriteLinkedRefsInContents(
      contents,
      ctx.rm.getFileLocaleMap(),
      ctx.module.framework,
      from,
      to,
      ns
    )) {
      linked.set(filePath, content);
      changed.set(filePath, content);
    }
  }
  await writeAllOrNothing(ctx.platform, changed);
  for (const { ns: ns2, from, to } of renames) {
    console.log(`renamed: ${qualifyKey(ns2, from)} -> ${qualifyKey(ns2, to)}`);
  }
  console.log(`files: ${collapsePaths([...changed.keys()])}`);
  if (linked.size) console.log(`linked references rewritten in: ${collapsePaths([...linked.keys()])}`);
}


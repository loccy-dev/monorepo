function serializeValue(value) {
  if (Array.isArray(value)) {
    return JSON.stringify(value);
  }
  return value;
}
function deserializeValue(value) {
  if (typeof value !== "string") {
    return value;
  }
  try {
    const trimmed = value.trimStart();
    if (trimmed.startsWith("[")) {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) {
        return parsed;
      }
    }
  } catch {
  }
  return value;
}
function flattenObject(obj, parentKey = "", result = {}) {
  for (const [key, value] of Object.entries(obj)) {
    const keypath = parentKey ? `${parentKey}.${key}` : key;
    const serialized = serializeValue(value);
    if (serialized !== value) {
      result[keypath] = serialized;
    } else if (value && typeof value === "object") {
      flattenObject(value, keypath, result);
    } else {
      result[keypath] = value;
    }
  }
  return result;
}
function getLineIndex(text, position) {
  let lineIndex = 0;
  for (let i = 0; i < position; i++) {
    if (text[i] === "\n") {
      lineIndex++;
    }
  }
  return lineIndex;
}
function sortObjectKeys(obj) {
  if (obj === null || typeof obj !== "object") {
    return obj;
  }
  if (Array.isArray(obj)) {
    return obj.map(sortObjectKeys);
  }
  return Object.keys(obj).sort().reduce((acc, key) => {
    acc[key] = sortObjectKeys(obj[key]);
    return acc;
  }, {});
}
function s(count, suffix = "s") {
  if (count === 1) {
    return "";
  }
  return suffix;
}
function mostCommon(items) {
  const counts = /* @__PURE__ */ new Map();
  for (const item of items) counts.set(item, (counts.get(item) ?? 0) + 1);
  return [...counts.entries()].sort(([a], [b]) => a.localeCompare(b)).sort(([, a], [, b]) => b - a)[0]?.[0];
}


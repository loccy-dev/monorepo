// ../../packages/shared/src/core/loccy-config/config-templates.ts
var CONFIG_YAML_HEADER = `# yaml-language-server: $schema=${LOCCY_SCHEMA_URL}

# Single config for Loccy i18n tools
# ${LOCCY_HOME}`;
function q(value) {
  return `'${value.replace(/'/g, "''")}'`;
}
function block(items, indent2) {
  return items.map((item) => `
${indent2}- ${q(item)}`).join("");
}
function renderLayout(layout) {
  return typeof layout === "string" ? q(layout) : `{ ${Object.entries(layout).map(([k, v]) => `${q(k)}: ${q(v)}`).join(", ")} }`;
}
function renderModule(module2) {
  const { framework, usages, translations } = module2;
  const ext = extractFileExt(translations.glob) || "json";
  const layoutIsDefault = typeof translations.layout === "string" && translations.layout === frameworkDefaultLayout(framework, ext);
  const layoutLine = layoutIsDefault ? "" : `
      layout: ${renderLayout(translations.layout)}`;
  const sortKeysLine = translations.sortKeys ? `
      sortKeys: true` : "";
  const translationsExcludeLine = translations.exclude?.length ? `
      exclude:${block(translations.exclude, "        ")}` : "";
  const messageFormatIsDefault = translations.messageFormat === getFramework(framework)?.messageFormats[0];
  const messageFormatLine = messageFormatIsDefault ? "" : `
      messageFormat: ${translations.messageFormat}`;
  const usagesExcludeLine = usages.exclude?.length ? `
      exclude:${block(usages.exclude, "        ")}` : "";
  const customTFunctionsLine = usages.customTFunctions?.length ? `
      customTFunctions:${block(usages.customTFunctions, "        ")}` : "";
  const detectKeysInStringsLine = usages.detectKeysInStrings === false ? `
      detectKeysInStrings: false` : "";
  return `    framework: ${framework}
    translations:
      glob: ${q(translations.glob)}${messageFormatLine}${layoutLine}${sortKeysLine}${translationsExcludeLine}
    usages:
      include:${block(usages.include, "        ")}${usagesExcludeLine}${customTFunctionsLine}${detectKeysInStringsLine}`;
}
var STYLEGUIDE_SCAFFOLD = `${STYLEGUIDE_EXAMPLE_YAML.trimEnd().split("\n").map((line) => line ? `# ${line}` : "#").join("\n")}
`;
function hasRealStyleguide(styleguide) {
  return !!styleguide && Object.values(styleguide).some((v) => Array.isArray(v) ? v.length : !!v);
}
function renderStyleguideYaml(styleguide) {
  return dump({ styleguide }, { indent: 2, lineWidth: -1, noRefs: true, sortKeys: false });
}
function renderLoccyConfigYaml(config) {
  const modulesYaml = Object.entries(config.modules).map(([name, module2]) => `  ${name}:
${renderModule(module2)}`).join("\n\n");
  const styleguideYaml = hasRealStyleguide(config.styleguide) ? renderStyleguideYaml(config.styleguide) : STYLEGUIDE_SCAFFOLD;
  return `${CONFIG_YAML_HEADER}

modules:
${modulesYaml}

${styleguideYaml}`;
}

// ../../packages/shared/src/core/loccy-config/defaults-detection/from-project-deps.ts
var MANIFESTS = [
  { glob: "**/package.json", exclude: "**/node_modules/**", depKeys: ["dependencies", "devDependencies"] },
  { glob: "**/composer.json", exclude: "**/vendor/**", depKeys: ["require", "require-dev"] }
];
async function collectAllProjectDeps(platform) {
  const result = /* @__PURE__ */ new Set();
  for (const { glob, exclude, depKeys } of MANIFESTS) {
    const manifestFiles = await platform.findFiles([glob], [exclude]);
    for (const filePath of manifestFiles) {
      try {
        const content = await platform.readFile(filePath);
        const manifest = JSON.parse(content);
        for (const depKey of depKeys) {
          for (const dep of Object.keys(manifest[depKey] ?? {})) result.add(dep);
        }
      } catch {
        continue;
      }
    }
  }
  return result;
}

// ../../packages/shared/src/core/loccy-config/defaults-detection/parse-resource-file-safe.ts
async function parseResourceFileSafe(platform, filePath) {
  try {
    const format2 = getResourceFormatByExt(extractFileExt(filePath));
    if (!format2) return null;
    const content = await platform.readFile(filePath);
    if (!content.trim()) return null;
    const doc = parseResourceFile(format2, content);
    if (!Object.keys(doc.data).length) return null;
    return doc;
  } catch {
    return null;
  }
}

// ../../packages/shared/src/core/loccy-config/defaults-detection/detect-translations-location.ts
var POPULAR_LOCALIZATION_DIRS = {
  i18n: 10,
  l10n: 9,
  locales: 9,
  locale: 8,
  translations: 8,
  lang: 7,
  languages: 6,
  intl: 6,
  messages: 5,
  localization: 5,
  resources: 4,
  translate: 4,
  assets: 3,
  strings: 3
};
async function detectTranslationsLocation(platform) {
  const patterns = listResourceFormats().flatMap((format2) => format2.extensions.map((ext) => `**/*.${ext}`));
  const allResourceFiles = await platform.findFiles(patterns);
  const allPossibleResourceFiles = allResourceFiles.filter((filePath) => {
    return looksLikeNamespaceStructure(filePath) || looksLikeLocaleStructure(filePath);
  });
  const dirGroups = {};
  for (const filePath of allPossibleResourceFiles) {
    let dir = extractDirname(filePath);
    if (looksLikeNamespaceStructure(filePath)) {
      const segments = filePath.split("/");
      const localeIndex = segments.findIndex((seg) => isLocaleLike(seg));
      if (localeIndex > 0) {
        dir = segments.slice(0, localeIndex).join("/");
      }
    }
    ;
    (dirGroups[dir] ??= { paths: [] }).paths.push(filePath);
  }
  if (Object.keys(dirGroups).length === 0) {
    return [];
  }
  const candidates = [];
  for (const [dir, { paths }] of Object.entries(dirGroups)) {
    let score = 0;
    const segments = dir.split("/");
    for (const [pattern2, patternScore] of Object.entries(POPULAR_LOCALIZATION_DIRS)) {
      if (segments.includes(pattern2)) {
        score += patternScore;
        break;
      }
    }
    if (paths.length >= 2) {
      const similarity = await computeJaccardSimilarity(platform, paths);
      score += similarity * 10;
    }
    candidates.push({ dir, score, paths });
  }
  return candidates.sort((a, b) => b.score - a.score);
}
async function computeJaccardSimilarity(platform, paths) {
  const keysList = [];
  const namespaceGroups = {};
  for (const filePath of paths) {
    if (looksLikeNamespaceStructure(filePath)) {
      const filename = extractFileName(filePath, true);
      if (!namespaceGroups[filename]) {
        namespaceGroups[filename] = [];
      }
      namespaceGroups[filename].push(filePath);
    } else {
      keysList.push(await getJsonKeys(platform, filePath));
    }
  }
  for (const namespacePaths of Object.values(namespaceGroups)) {
    if (namespacePaths.length > 1) {
      for (const filePath of namespacePaths) {
        keysList.push(await getJsonKeys(platform, filePath));
      }
      break;
    }
  }
  if (keysList.length < 2) {
    return 0;
  }
  let totalSimilarity = 0;
  let pairs2 = 0;
  for (const [i, setA] of keysList.entries()) {
    for (const setB of keysList.slice(i + 1)) {
      const intersection = new Set([...setA].filter((x) => setB.has(x)));
      const union = /* @__PURE__ */ new Set([...setA, ...setB]);
      const similarity = union.size === 0 ? 0 : intersection.size / union.size;
      totalSimilarity += similarity;
      pairs2++;
    }
  }
  return pairs2 > 0 ? totalSimilarity / pairs2 : 0;
}
async function getJsonKeys(platform, filePath) {
  const doc = await parseResourceFileSafe(platform, filePath);
  return new Set(doc ? Object.keys(doc.data) : []);
}

// ../../packages/shared/src/core/loccy-config/defaults-detection/detect-resource-structure.ts
function detectResourceStructure(allPaths, preset) {
  const defaultFilenameMeaningInI18nFramework = getFramework(preset)?.defaultFilenameMeaning;
  let namespaceScore = 0;
  let localeScore = 0;
  for (const path5 of allPaths) {
    if (looksLikeNamespaceStructure(path5)) {
      namespaceScore++;
    }
    if (looksLikeLocaleStructure(path5)) {
      localeScore++;
    }
  }
  if (namespaceScore === localeScore && defaultFilenameMeaningInI18nFramework) {
    return defaultFilenameMeaningInI18nFramework;
  }
  return namespaceScore > localeScore ? "namespace" : "locale";
}

// ../../packages/shared/src/core/loccy-config/initialize-config.ts
async function inspectResourceFiles(paths, platform) {
  let hasData = false;
  let sorted = true;
  for (const filePath of paths) {
    const doc = await parseResourceFileSafe(platform, filePath);
    if (!doc) continue;
    hasData = true;
    if (sorted && !detectSortKeysFromDocument(doc)) {
      sorted = false;
    }
  }
  return { hasData, sorted };
}
function dominantExtension(paths) {
  return mostCommon(paths.map(extractFileExt)) ?? "json";
}
async function initializeConfig(platform) {
  const allDeps = await collectAllProjectDeps(platform);
  const translationFileCandidates = await detectTranslationsLocation(platform);
  if (!translationFileCandidates.length) {
    return null;
  }
  const { dir, paths } = translationFileCandidates[0];
  const i18nFramework = detectFrameworkFromDeps(allDeps) ?? "custom";
  const framework = getFramework(i18nFramework);
  if (!framework) {
    return null;
  }
  const filenameRepresents = detectResourceStructure(paths, i18nFramework);
  const { hasData, sorted: sortKeys } = await inspectResourceFiles(paths, platform);
  if (!hasData) {
    return null;
  }
  const ext = dominantExtension(paths);
  const layout = buildLayout(filenameRepresents, ext);
  const resourceFormat = getResourceFormatByExt(ext);
  const messageFormat = resolveMessageFormatId(framework, allDeps, resourceFormat);
  return {
    modules: {
      default: {
        name: "default",
        framework: i18nFramework,
        usages: {
          include: [framework.defaultSourceGlob],
          exclude: [],
          customTFunctions: [],
          detectKeysInStrings: true,
          noUnresolvedKeys: true,
          noUnusedKeys: true
        },
        translations: {
          messageFormat,

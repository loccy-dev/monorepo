function deleteKeypath(data, keypath, structure) {
  const root2 = data;
  if (structure === "nested") {
    const keypathArray = keypath.split(".");
    let current = root2;
    const path5 = [current];
    for (let i = 0; i < keypathArray.length - 1; i++) {
      const key = keypathArray[i];
      const next = current[key];
      if (!next || typeof next !== "object") {
        return;
      }
      current = next;
      path5.push(current);
    }
    const targetKey = keypathArray[keypathArray.length - 1];
    const val = current[targetKey];
    if (!(targetKey in current)) {
      return void 0;
    }
    delete current[targetKey];
    for (let i = keypathArray.length - 2; i >= 0; i--) {
      const parentObj = path5[i];
      const key = keypathArray[i];
      const child = parentObj[key];
      if (typeof child === "object" && Object.keys(child).length === 0) {
        delete parentObj[key];
      } else {
        break;
      }
    }
    return val;
  } else {
    const val = root2[keypath];
    delete root2[keypath];
    return val;
  }
}
function canCollapseWithoutDataLoss(data, oldKeypath, newKeypath) {
  let current = data;
  const parentPath = newKeypath.split(".");
  const remainderPath = oldKeypath.slice(newKeypath.length + 1).split(".");
  for (const key of parentPath) {
    const next = current[key];
    if (typeof next === "object") current = next;
  }
  for (const key of remainderPath) {
    if (Object.keys(current).length > 1) return false;
    const next = current[key];
    if (typeof next === "object") current = next;
  }
  return true;
}
function isNewKeypathValid(data, oldKeypath, newKeypath) {
  let current = data;
  if (newKeypath.startsWith(oldKeypath + ".")) {
    return true;
  }
  if (oldKeypath.startsWith(newKeypath + ".")) {
    return canCollapseWithoutDataLoss(data, oldKeypath, newKeypath);
  }
  for (const key of newKeypath.split(".")) {
    const val = current[key];
    if (!val) return true;
    if (typeof val !== "object") return false;
    current = val;
  }
  return false;
}
function shouldRenameOnly(data, oldKeypath, newKeypath) {
  const oldKeypathArray = oldKeypath.split(".");
  const newKeypathArray = newKeypath.split(".");
  let level = 0;
  for (let i = 0; i < newKeypathArray.length; i++) {
    if (newKeypathArray[i] === oldKeypathArray[i]) {
      level++;
    } else {
      break;
    }
  }
  const commonPathBeginning = oldKeypathArray.slice(0, level).join(".");
  const oldKeypathArrayDiff = oldKeypathArray.slice(level);
  const newKeypathArrayDiff = newKeypathArray.slice(level);
  let obj = commonPathBeginning ? get_default(data, commonPathBeginning) : data;
  for (const key of oldKeypathArrayDiff) {
    if (typeof obj[key] !== "object") {
      continue;
    }
    obj = obj[key];
    if (Object.keys(obj).length === 1) {
      continue;
    }
    return false;
  }
  obj = commonPathBeginning ? get_default(data, commonPathBeginning) : data;
  const firstNewDiff = newKeypathArrayDiff[0];
  return firstNewDiff === void 0 || obj[firstNewDiff] === void 0;
}
function renameKeypathWithoutMovement(data, oldKeypath, newKeypath) {
  const oldValue = get_default(data, oldKeypath);
  const oldKeypathArray = oldKeypath.split(".");
  const newKeypathArray = newKeypath.split(".");
  const renameKey = (obj, from, to) => Object.fromEntries(Object.entries(obj).map(([k, v]) => [k === from ? to : k, v]));
  let result = data;
  for (let i = 0; i < Math.max(newKeypathArray.length, oldKeypathArray.length); i++) {
    const oldPathPart = oldKeypathArray[i];
    const newPathPart = newKeypathArray[i];
    if (i === 0) {
      result = renameKey(result, oldPathPart ?? "", newPathPart ?? "");
    } else if (oldPathPart === void 0) {
      set_default(result, newKeypath, oldValue);
    } else if (newPathPart === void 0) {
      const updatedOldKeypath = [newKeypathArray, ...oldKeypathArray.slice(i)].join(".");
      deleteKeypath(result, updatedOldKeypath, "nested");
      set_default(result, newKeypath, oldValue);
    } else {
      const pathToObject = newKeypathArray.slice(0, i).join(".");
      const currObj = get_default(result, pathToObject);
      set_default(result, pathToObject, renameKey(currObj, oldPathPart, newPathPart));
    }
  }
  return result;
}
function renameKeypath(data, structure, oldKeypath, newKeypath) {
  const keypathExists = get_default(data, oldKeypath) !== void 0;
  if (!keypathExists) {
    return data;
  }
  if (!isNewKeypathValid(data, oldKeypath, newKeypath)) {
    return data;
  }
  if (structure === "nested") {
    if (shouldRenameOnly(data, oldKeypath, newKeypath)) {
      return renameKeypathWithoutMovement(data, oldKeypath, newKeypath);
    } else {
      const val = deleteKeypath(data, oldKeypath, structure);
      if (!val) {
        return data;
      }
      updateValue(data, structure, newKeypath, val);
      return data;
    }
  } else {
    return Object.fromEntries(
      Object.entries(data).map(([k, v]) => {
        if (k === oldKeypath) {
          return [newKeypath, v];
        }
        return [k, v];
      })
    );
  }
}

// ../../packages/shared/src/core/resources/nested-tree-parser.ts
var NestedTreeParser = class {
  data;
  metadata;
  sortKeys;
  constructor(data, metadata, sortKeys) {
    this.data = data;
    this.metadata = metadata;
    this.sortKeys = sortKeys;
  }
  get flatData() {
    return flattenObject(this.data);
  }
  // also used for new keypath insertion
  updateValue(keypath, newValue) {
    updateValue(this.data, this.metadata.structure, keypath, newValue);
  }
  deleteKeypath(keypath) {
    return deleteKeypath(this.data, keypath, this.metadata.structure);
  }
  renameKeypath(oldKeypath, newKeypath) {
    this.data = renameKeypath(this.data, this.metadata.structure, oldKeypath, newKeypath);
  }
};

// ../../packages/shared/src/core/resources/json-parser.ts
var JsonParser = class _JsonParser extends NestedTreeParser {
  static fromObject(data, metadata) {
    const parser = Object.create(_JsonParser.prototype);
    parser.data = data;
    parser.metadata = metadata;
    parser.sortKeys = resolveSortKeys(data, metadata.sortKeys);
    return parser;
  }
  constructor(content, sortKeys) {
    const parsedContent = JSON.parse(content);
    if (typeof parsedContent !== "object" || parsedContent === null || Array.isArray(parsedContent)) {
      throw new Error("JSON root must be an object");
    }
    const data = parsedContent;
    const metadata = {
      trailingNewLines: detectTrailingNewLines(content),
      indentString: detectIndentation(content),
      sortKeys,
      structure: detectStructure(data)
    };
    super(data, metadata, resolveSortKeys(data, sortKeys));
  }

  );
}

// src/commands/hook.ts
import { createHash as createHash2, randomUUID } from "node:crypto";
import { mkdir as mkdir2, writeFile as writeFile2 } from "node:fs/promises";
import { statSync } from "node:fs";
import { tmpdir as tmpdir2 } from "node:os";
var import_picomatch = __toESM(require_picomatch4(), 1);

// src/tool-commands.ts
var COMMANDS = [
  { usage: "init", summary: "scaffold loccy.yaml, for a project that has none yet" },
  {
    usage: "search [query...]",
    summary: "read messages by text regex, --key <regex> (or `-` for a key list on stdin). --json"
  },
  { usage: "upsert-message", summary: "add or update keys across every locale (JSON on stdin)" },
  {
    usage: "remove-message <key...>",
    summary: "remove keys from every locale"
  },
  { usage: "rename-key", summary: "rename across locales and linked refs, source untouched (JSON on stdin)" },
  { usage: "styleguide", summary: "the writing rules, read whole before adding/editing translations" }
];
var WIDTH = Math.max(...COMMANDS.map((command) => command.usage.length));
function renderCommands(indent2 = "  ") {
  return COMMANDS.map((command) => `${indent2}${command.usage.padEnd(WIDTH)}  ${command.summary}`).join("\n");
}
var BATCH_SYNTAX = `Writes are keyed by keypath on stdin, one key in the object or many: \`upsert-message\` reads
\`{key: {locale: value}}\`, \`rename-key\` reads \`{old: new}\`. \`remove-message\` takes keys as arguments.
Every batch is all-or-nothing: no file changes unless all of them can.`;
function workflow(bin = "loccy-tool") {
  return `${bin}: CLI to manage i18n, designed for AI coding agents.
Use it instead of reading or editing translation files by hand. Don't grep, read or write them directly.

Translation files are all it touches. The keys in your source are yours: no call site is ever
written, moved or deleted here, so a key you add still has to be called, and one you rename or
remove leaves references behind for you to update.

${renderCommands()}

${BATCH_SYNTAX}

Pass --help to any command for details.`;
}

// src/commands/setup.ts
var MAX_FILES_LISTED = 20;
async function describeSetup(platform, config) {
  const modules = Object.entries(config.modules);
  const yaml = modules.map(([name, module2]) => `  ${name}:
${renderModule(module2)}`).join("\n\n");
  const detected = [];
  let mostNamespaces = 0;
  for (const [name, module2] of modules) {
    const rm2 = await createResourceManager(platform, module2);
    const prefix = modules.length > 1 ? `${name}: ` : "";
    const locales = rm2?.allLocales ?? [];
    if (locales.length) detected.push(`${prefix}locales: ${locales.join(", ")}`);
    const files = [...rm2?.getFileLocaleMap().keys() ?? []];
    if (files.length) detected.push(`${prefix}translation files: ${collapsePaths(files, MAX_FILES_LISTED)}`);
    const namespaces = (rm2?.namespaces ?? []).filter((ns) => ns !== NS_WITHOUT_NS);
    mostNamespaces = Math.max(mostNamespaces, namespaces.length);
    detected.push(`${prefix}namespaces: ${namespaces.length ? namespaces.join(", ") : "none"}`);
  }
  if (modules.length > 1) {
    detected.push(`
Every command needs --module, since this project has more than one.`);
  }
  return { blocks: `modules:
${yaml}

${detected.join("\n")}`, mostNamespaces };
}
function whereTheBinaryIs(bin) {
  return `Run loccy-tool by its full path: ${bin}`;
}
async function buildStartupContext(platform, bin) {
  const config = await readConfigFile(platform);
  if (!config) return whereTheBinaryIs(bin);
  const { blocks, mostNamespaces } = await describeSetup(platform, config);
  const sections = [`## This project uses i18n

${blocks}`, whereTheBinaryIs(bin), workflow(bin)];
  const dropped = droppedStyleguideNote(config);
  if (dropped) sections.push(dropped);
  if (mostNamespaces > 1) {
    sections.push("Project uses several namespaces, so --ns is required on every command that takes it.");
  } else if (!mostNamespaces) {
    sections.push("Project doesn't use namespaces, never pass --ns.");
  }
  return sections.join("\n\n");
}

// src/commands/hook.ts
async function readHookInput() {
  const raw = await readStdin();
  if (!raw.trim()) return null;
  try {
    return JSON.parse(raw);
  } catch {
    return null;
  }
}
function emit(payload, debug) {
  const json2 = JSON.stringify(payload, null, debug ? 2 : 0);
  console.log(debug ? json2.replace(/(?<!\\)\\n/g, "\n") : json2);
}
function silent(debug, reason) {
  if (debug) console.error(`no output: ${reason}`);
}
function reasonFor(err) {
  return err instanceof LoccyConfigError ? err.message : null;
}
async function anyTranslationFile(platform, config) {
  for (const module2 of Object.values(config.modules)) {
    const rm2 = await createResourceManager(platform, module2);
    const [file] = rm2 ? rm2.getFileLocaleMap().keys() : [];
    if (file) return file;
  }
  return null;
}
function moduleOwning(config, relativePath) {
  for (const [name, module2] of Object.entries(config.modules)) {
    const excluded = module2.translations.exclude ?? [];
    if (excluded.length && import_picomatch.default.isMatch(relativePath, excluded)) continue;
    if (import_picomatch.default.isMatch(relativePath, module2.translations.glob)) return name;
  }
  return null;
}
var UNLOCK_MS = 5 * 60 * 1e3;
async function redirect(sessionId, relativePath) {
  const digest = (value) => createHash2("sha1").update(value).digest("hex").slice(0, 16);
  const dir = join(tmpdir2(), "loccy-tool-guard", digest(sessionId));
  const marker = join(dir, digest(relativePath));
  try {
    if (Date.now() - statSync(marker).mtimeMs < UNLOCK_MS) return false;
  } catch {
  }
  try {
    await mkdir2(dir, { recursive: true });
    await writeFile2(marker, relativePath);
    return true;
  } catch {
    return false;
  }
}
async function preEditHook(debug, file) {
  const input = await readHookInput();
  const cwd2 = input?.cwd ?? process.cwd();
  const platform = createNodePlatform(cwd2);
  let config;
  try {
    config = await readConfigFile(platform);
  } catch (err) {
    return silent(debug, reasonFor(err) ?? `${loccyConfigFilename} in ${cwd2} does not load`);
  }
  if (!config) return silent(debug, `no ${loccyConfigFilename} in ${cwd2}, so the guard governs nothing there`);
  const named = file ?? input?.tool_input?.file_path;
  const filePath = named ?? (debug ? await anyTranslationFile(platform, config) : null);
  if (!filePath) return silent(debug, `no file named, and the translation globs matched none in ${cwd2}`);
  const relativePath = isAbsolute(filePath) ? relative(cwd2, filePath) : filePath;
  if (relativePath.startsWith("..")) return silent(debug, `${filePath} is outside ${cwd2}`);
  if (!moduleOwning(config, relativePath)) {
    return silent(debug, `${relativePath} matches no module's translations.glob`);
  }
  const session = debug ? `debug:${randomUUID()}` : input?.session_id ?? "no-session";
  if (!await redirect(session, relativePath)) {
    return silent(debug, `${relativePath} is inside its ${UNLOCK_MS / 6e4}-minute unlock window`);
  }
  emit(
    {
      hookSpecificOutput: {
        hookEventName: "PreToolUse",
        permissionDecision: "deny",
        permissionDecisionReason: `${relativePath} holds translations, and those are written with loccy-tool upsert-message (see --help). If you do need to edit it by hand, repeat the edit and this lock lifts for the next 5 minutes.`
      }
    },
    debug
  );
}
async function sessionStartHook(debug) {
  const input = await readHookInput();
  startLog();
  const cwd2 = input?.cwd ?? process.cwd();
  const bin = process.argv[1] ?? "loccy-tool";
  const context = await buildStartupContext(createNodePlatform(cwd2), bin).catch(
    (err) => `# Loccy

\`${loccyConfigFilename}\` does not load, so every ${bin} command will fail until it does:

${reasonFor(err) ?? String(err)}`
  );
  emit(
    {
      // The trace is never mentioned here: it exists to show what a session does unprompted, and
      // saying it is on would change that.
      hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: context },
      suppressOutput: true
    },
    debug
  );
}

// src/program.ts
function withModuleOptions(command) {
  return command.option("--module <name>", "i18n module to target. Only needed where the project has several");
}
function withKeyOptions(command) {
  return withModuleOptions(command).option(
    "--ns <namespace>",
    "Namespace the keys belong to (only needed where several hold the same keypath)"
  );
}
function addHookCommands(program2) {
  const hooks = [
    { name: "hook-session-start", run: sessionStartHook },
    {
      name: "hook-pre-edit",
      run: preEditHook,
      argument: ["[file]", "Translation file the edit would touch. Omit it and the project's own is used"]
    }
  ];
  for (const { name, run, argument } of hooks) {
    program2.command(name, { hidden: true }).action(() => run(false));
    const debug = program2.command(`${name}-debug`, { hidden: true });
    if (argument) debug.argument(...argument).action((value) => run(true, value));
    else debug.action(() => run(true));
  }
}
function buildProgram() {
  const program2 = new Command();
  program2.name("loccy-tool").version(plugin_default.version, "-v, --version").showHelpAfterError(workflow());
  program2.command("init").description(`Scaffold ${loccyConfigFilename} from auto-detection. Only for a project that has none yet`).addHelpText(
    "after",
    `
Every other command reads ${loccyConfigFilename}, so this is the one to run first. It never
overwrites an existing file: edit that one, against the field reference at ${LOCCY_SCHEMA_URL}`
  ).action(initCommand);
  withKeyOptions(
    program2.command("search").description("Read messages: match locale text, the keypath, or both at once. Queries are regular expressions").argument("[query...]", "Pattern the text must match (case-insensitive). Several are searched in one call").option(
      "--key <pattern>",
      "Keypath to match, narrowing the text query rather than replacing it. `-` reads exact keypaths from stdin, one per line"
    ).option("--locale <locale>", "Search and show only this locale").option("--json", "Print the whole call as one JSON document, for joining against something else").option("--limit <n>", "Max matches to print in full, per term. Uncapped unless you say so")
  ).addHelpText(
    "after",
    `
Every query is a case-insensitive regular expression, over the text by default:

  loccy-tool search Reservierung --locale de
  loccy-tool search Reservierung Buchung Termin --locale de
  loccy-tool search 'Could ?n.t' --locale en

--key matches the keypath instead, for the other question: which message is this key from
source, or what sits under this group. Alone it is the whole search; with a term it narrows it.

  loccy-tool search --key login
  loccy-tool search --key '^Tickets\\..*Tooltip$'
  loccy-tool search '\\.$' --key '^(?!.*[Tt]ooltip)' --locale en

A phrase out of the UI is the same thing with its pattern characters escaped:

  loccy-tool search "Are you sure\\? \\(optional\\)"

Keep patterns simple: nested quantifiers can hang the search.

Holding a key list already, from a grep over the source that calls them, pipe it in and read
the values back rather than opening the locale files. Those are matched exactly, never as
patterns:

  grep -rhoE "t\\('[A-Za-z0-9_.]+'\\)" src | sed -E "s/.*'(.*)'.*/\\1/" | sort -u \\
    | loccy-tool search --key - --locale en --json

--json prints one document per call: every block, its total, and each match with the value
each locale holds. That is the form to join against grep output or feed to jq.

Each match prints its value in every locale. Several terms get a block each, in the order
given, which is how a glossary candidate is checked for drift in one call.

A namespace goes in --ns, and a keypath is always bare.`
  ).action(searchCommand);
  withKeyOptions(
    program2.command("upsert-message").description("Add or update keys across every locale file in one call").option(
      "--styleguided <token>",
      "Confirm the rules were read. `loccy-tool styleguide` prints them and the token that goes here"
    )
  ).addHelpText(
    "after",
    '\nKeys and values go in as JSON on stdin, so nothing needs shell-escaping. One key or many,\nalways keyed by keypath:\n\n  loccy-tool upsert-message <<\'EOF\'\n  {"login.title":{"en":"Sign in","de":"Anmelden"},"login.ok":{"en":"Continue","de":"Weiter"}}\n  EOF\n\nRun it with no stdin at all to get the exact locale set as a skeleton to fill.\nA namespace goes in --ns, never spelled into the keys.\n\nAn empty string deletes the key from that locale file, leaving the others untouched: the way\nto make one locale fall back while the rest keep their own text:\n\n  {"login.ok":{"en":"Continue","de":"Weiter","de-AT":"","de-DE":""}}\n\nAlways enforced: every primary locale present in one call, and no partial-override locale\nrepeating the locale it extends. Atomic - nothing is written unless every key in the batch can be.\n\nRun `loccy-tool styleguide` before the first call, and pass the token it prints as\n--styleguided from that write on.'
  ).action(upsertMessageCommand);
  withKeyOptions(
    program2.command("remove-message").description("Remove keys from every locale file that holds them").argument("<key...>", "Keypaths to remove, e.g. login.title.")
  ).addHelpText(
    "after",
    "\n  loccy-tool remove-message login.old                  # i18n setup without namespaces\n  loccy-tool remove-message login.old --ns auth        # namespaced i18n setup\n  loccy-tool remove-message login.old signup.old       # several at once, all or nothing"
  ).action(removeMessageCommand);
  withKeyOptions(program2.command("rename-key").description("Rename keys across every locale file")).addHelpText(
    "after",
    '\nRenames go in as JSON on stdin, one pair or many, applied all or nothing:\n\n  loccy-tool rename-key <<\'EOF\'\n  {"login.title":"login.heading","login.ok":"login.confirm"}\n  EOF\n\nA namespace goes in --ns, never spelled into the keys, and a rename never crosses one.\nA key already in use is never renamed onto: merge deliberately with upsert-message, then remove-message.\n\nLinked references between messages (`@:old.key`) follow the rename.'
  ).action(renameKeyCommand);
  program2.command("styleguide").description("The project's writing rules in full. Read all of it, never a slice").addHelpText(
    "after",
    "\nRead the output whole, and again whenever the rules may have moved: a write is checked against\nthese rules, and only what is in context can be written against. Piping this through head, tail\nor grep keeps the token at the end and drops the rules it stands for, leaving the next write\nconfirming something nobody read."
  ).action(styleguideCommand);
  program2.command("styleguide-example", { hidden: true }).action(styleguideExampleCommand);
  addHookCommands(program2);
  return program2;
}

// src/cli.ts
traceInvocation(process.argv);
var rootArg = process.argv[2];
var bareHelp = ["-h", "--help", "help"].includes(rootArg ?? "") && process.argv.length === 3;
if (!rootArg || bareHelp) {
  console.log(workflow());
  process.exit(0);
}
buildProgram().parseAsync(process.argv).catch((err) => {
  console.error(`error: ${err instanceof Error ? err.message : String(err)}`);
  process.exit(1);
});

// ../../packages/shared/src/core/resources/properties-parser.ts
function hasContinuation(line) {
  let slashes = 0;
  for (let i = line.length - 1; i >= 0 && line[i] === "\\"; i--) slashes++;
  return slashes % 2 === 1;
}
function unescape(s2) {
  let out = "";
  for (let i = 0; i < s2.length; i++) {
    if (s2[i] !== "\\") {
      out += s2[i];
      continue;
    }
    const next = s2[++i];
    if (next === "n") out += "\n";
    else if (next === "t") out += "	";
    else if (next === "r") out += "\r";
    else if (next === "f") out += "\f";
    else if (next === "u") {
      out += String.fromCharCode(parseInt(s2.slice(i + 1, i + 5), 16));
      i += 4;
    } else out += next ?? "";
  }
  return out;
}
function escapeKey(key) {
  return key.replace(/[\\=: \t\f\n\r]/g, (c) => {
    if (c === "\n") return "\\n";
    if (c === "	") return "\\t";
    if (c === "\r") return "\\r";
    if (c === "\f") return "\\f";
    return "\\" + c;
  });
}
function escapeValue(value) {
  return value.replace(/\\/g, "\\\\").replace(/\n/g, "\\n").replace(/\t/g, "\\t").replace(/\r/g, "\\r").replace(/\f/g, "\\f").replace(/^ /, "\\ ");
}
function splitEntry(line) {
  let i = 0;
  while (i < line.length) {
    const c = line[i];
    if (c === "\\") {
      i += 2;
      continue;
    }
    if (c === "=" || c === ":" || c === " " || c === "	" || c === "\f") break;
    i++;
  }
  const rawKey = line.slice(0, i);
  while (i < line.length && /[ \t\f]/.test(line[i])) i++;
  if (line[i] === "=" || line[i] === ":") {
    i++;
    while (i < line.length && /[ \t\f]/.test(line[i])) i++;
  }
  return { rawKey, rawValue: line.slice(i) };
}
var PropertiesParser = class _PropertiesParser {
  data;
  metadata;
  sortKeys;
  static fromObject(data, metadata) {
    const parser = Object.create(_PropertiesParser.prototype);
    parser.data = data;
    parser.metadata = metadata;
    parser.sortKeys = resolveSortKeys(data, metadata.sortKeys);
    return parser;
  }
  constructor(content, sortKeys) {
    const data = {};
    const lines = content.split(/\r?\n/);
    for (let i = 0; i < lines.length; i++) {
      let line = lines[i].replace(/^[ \t\f]+/, "");
      if (line === "" || line[0] === "#" || line[0] === "!") continue;
      while (hasContinuation(line) && i + 1 < lines.length) {
        line = line.slice(0, -1) + lines[++i].replace(/^[ \t\f]+/, "");
      }
      const { rawKey, rawValue } = splitEntry(line);
      if (!rawKey) continue;
      data[unescape(rawKey)] = unescape(rawValue);
    }
    this.data = data;
    this.metadata = { trailingNewLines: detectTrailingNewLines(content), sortKeys };
    this.sortKeys = resolveSortKeys(data, sortKeys);
  }
  get entries() {
    const keys2 = Object.keys(this.data);
    if (this.sortKeys) keys2.sort();
    return keys2.map((k) => [k, String(this.data[k] ?? "")]);
  }
  get content() {
    const body = this.entries.map(([k, v]) => `${escapeKey(k)}=${escapeValue(v)}`).join("\n");
    return body + "\n".repeat(this.metadata.trailingNewLines || 1);
  }
  get flatData() {
    return Object.fromEntries(this.entries);
  }
  cloneEmpty() {
    return _PropertiesParser.fromObject({}, { ...this.metadata });
  }
  updateValue(keypath, newValue) {
    ;
    this.data[keypath] = newValue;
  }
  deleteKeypath(keypath) {
    const prev = this.data[keypath];
    delete this.data[keypath];
    return typeof prev === "string" ? prev : void 0;
  }
  renameKeypath(oldKeypath, newKeypath) {
    const rebuilt = {};
    for (const [k, v] of Object.entries(this.data)) {
      rebuilt[k === oldKeypath ? newKeypath : k] = v;
    }
    this.data = rebuilt;
  }
};

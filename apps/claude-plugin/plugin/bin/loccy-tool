function jsonKeypathRanges(text) {
  const result = [];
  const start = text.indexOf("{");
  if (start === -1) return result;
  let pos = start;
  const skipWs = () => {
    while (pos < text.length && /\s/.test(text[pos])) pos++;
  };
  const parseString = () => {
    const quote = text[pos];
    pos++;
    while (pos < text.length && text[pos] !== quote) {
      if (text[pos] === "\\") pos++;
      pos++;
    }
    pos++;
  };
  const parseIdent = () => {
    while (pos < text.length && /[a-zA-Z0-9_$]/.test(text[pos])) pos++;
  };
  const parseValue = (path5) => {
    skipWs();
    const ch = text[pos];
    if (ch === "{") {
      parseObject(path5);
    } else if (ch === "[") {
      let depth = 0;
      do {
        if (text[pos] === "[") depth++;
        else if (text[pos] === "]") depth--;
        else if (text[pos] === '"' || text[pos] === "'") {
          parseString();
          continue;
        }
        pos++;
      } while (pos < text.length && depth > 0);
    } else if (ch === '"' || ch === "'") {
      parseString();
    } else {
      while (pos < text.length && !/[,}\]]/.test(text[pos])) pos++;
    }
  };
  function parseObject(path5) {
    pos++;
    skipWs();
    while (pos < text.length && text[pos] !== "}") {
      skipWs();
      if (text[pos] === "}") break;
      const keyStart = pos;
      let key;
      if (text[pos] === '"' || text[pos] === "'") {
        const q2 = text[pos];
        const s2 = pos + 1;
        parseString();
        key = text.slice(s2, pos - 1).replace(new RegExp(`\\\\${q2}`, "g"), q2);
      } else {
        const s2 = pos;
        parseIdent();
        key = text.slice(s2, pos);
      }
      skipWs();
      if (text[pos] !== ":") break;
      pos++;
      skipWs();
      const keyPath = [...path5, key];
      const valueStart = pos;
      const isLeaf = text[valueStart] !== "{" && text[valueStart] !== "[";
      parseValue(keyPath);
      if (isLeaf) {
        result.push({ keypath: keyPath.join("."), loc: { start: keyStart, end: pos, line: lineAt(text, keyStart) } });
      }
      skipWs();
      if (text[pos] === ",") {
        pos++;
        skipWs();
      }
    }
    pos++;
  }
  try {
    parseObject([]);
  } catch {
  }
  return result;
}

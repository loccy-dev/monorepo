// ../../packages/shared/src/core/resources/format-detection.ts
function detectIndentation(content) {
  const match = content.match(/\n(\s+)/);
  const whitespace = match?.[1];
  if (!whitespace) return "";
  const firstChar = whitespace[0];
  if (firstChar === "	") {
    const tabCount = whitespace.match(/^\t+/)?.[0].length || 1;
    return "	".repeat(tabCount);
  }
  const spaceCount = whitespace.match(/^ +/)?.[0].length || 2;
  return " ".repeat(spaceCount);
}
function detectTrailingNewLines(content) {
  const match = content.match(/\n+$/);
  return match ? match[0].length : 0;
}


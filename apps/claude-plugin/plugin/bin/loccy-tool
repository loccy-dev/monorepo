// ../../packages/shared/src/core/plurals/plural-categories.ts
var PLURAL_CATEGORIES = ["zero", "one", "two", "few", "many", "other"];
function getPluralCategories(locales, numberType2 = "cardinal") {
  const categories = /* @__PURE__ */ new Set();
  for (const locale of locales) {
    try {
      const rules = new Intl.PluralRules(locale, { type: numberType2 });
      rules.resolvedOptions().pluralCategories.forEach((c) => categories.add(c));
    } catch {
    }
  }
  return PLURAL_CATEGORIES.filter((c) => categories.has(c));
}

// ../../packages/shared/src/core/message-formats/suffix-cldr.ts
function suffixFor(category, numberType2) {
  return numberType2 === "ordinal" ? `_ordinal_${category}` : `_${category}`;
}
var suffixCldrMessageFormat = {
  id: "suffix-cldr",
  interpolation: { open: "{{", close: "}}" },
  pluralKeyFor: (baseKey, category, numberType2) => `${baseKey}${suffixFor(category, numberType2)}`,
  parsePluralKey(keypath) {
    for (const category of PLURAL_CATEGORIES) {
      const numberType2 = keypath.endsWith(`_ordinal_${category}`) ? "ordinal" : keypath.endsWith(`_${category}`) ? "cardinal" : null;
      if (numberType2) {
        return {
          baseKey: keypath.slice(0, -suffixFor(category, numberType2).length),
          category,
          numberType: numberType2
        };
      }
    }
    return null;
  },
  expandPluralKeypaths(baseKey, { numberType: numberType2, locales, existingKeypaths }) {
    const categories = getPluralCategories(locales, numberType2);
    const withZero = !categories.includes("zero") && existingKeypaths.includes(this.pluralKeyFor(baseKey, "zero", numberType2)) ? ["zero", ...categories] : categories;
    return withZero.map((category) => this.pluralKeyFor(baseKey, category, numberType2));
  }
  // No valueCodec: suffix-cldr's plural lives across sibling keys, not inside a single value.
};

// ../../packages/shared/src/core/plurals/plural-model.ts
function orderedBranchKeys(branches) {
  const keys2 = Object.keys(branches);
  const exacts = keys2.filter((k) => k.startsWith("=")).sort((a, b) => Number(a.slice(1)) - Number(b.slice(1)));
  const categories = PLURAL_CATEGORIES.filter((c) => c !== "other" && keys2.includes(c));
  const other = keys2.includes("other") ? ["other"] : [];
  return [...exacts, ...categories, ...other];
}
function validateBranches(model, required, { requireOther }) {
  const issues = [];
  for (const category of required) {
    if (model.branches[category] === void 0) {
      issues.push(category === "other" ? { kind: "missing-other" } : { kind: "missing-category", category });
    }
  }
  if (requireOther && !required.includes("other") && model.branches["other"] === void 0) {
    issues.push({ kind: "missing-other" });
  }
  return issues;
}
function positionalBranches(segments, locale, numberType2 = "cardinal") {
  const resolved = getPluralCategories([locale], numberType2);
  const cats = resolved.length ? resolved : ["one", "other"];
  const branches = {};
  if (segments.length === cats.length + 1) {
    branches["=0"] = segments[0];
    cats.forEach((category, i) => branches[category] = segments[i + 1]);
    return branches;
  }
  segments.forEach((segment, i) => {
    const category = cats[i];
    if (category) branches[category] = segment;
  });
  return branches;
}
var cldrValueCodecDefaults = {
  requiredCategories: (locale, numberType2) => getPluralCategories([locale], numberType2),
  validate: (model, locale, numberType2) => validateBranches(model, getPluralCategories([locale], numberType2), { requireOther: true })
};

// ../../packages/shared/src/core/message-formats/icu.ts
function matchBrace(s2, open) {
  let depth = 0;
  for (let i = open; i < s2.length; i++) {
    if (s2[i] === "{") depth++;
    else if (s2[i] === "}" && --depth === 0) return i;
  }
  return -1;
}
var HEAD = /^\s*([^\s,{}]+)\s*,\s*(plural|selectordinal)\s*,\s*/;
var OFFSET = /^offset:\d+\s*/;
var SELECTOR = /^\s*(=\d+|\w+)\s*\{/;
function parseIcuPlural(value) {
  const trimmed = value.trim();
  if (trimmed[0] !== "{") return null;
  const close = matchBrace(trimmed, 0);
  if (close !== trimmed.length - 1) return null;
  const inner = trimmed.slice(1, close);
  const head = inner.match(HEAD);
  if (!head) return null;
  const countVar = head[1];
  const numberType2 = head[2] === "selectordinal" ? "ordinal" : "cardinal";
  let rest = inner.slice(head[0].length).replace(OFFSET, "");
  const branches = {};
  while (rest.length) {
    const sel = rest.match(SELECTOR);
    if (!sel) break;
    const braceOpen = sel[0].length - 1;
    const braceClose = matchBrace(rest, braceOpen);
    if (braceClose === -1) return null;
    branches[sel[1]] = rest.slice(braceOpen + 1, braceClose);
    rest = rest.slice(braceClose + 1);
  }
  return Object.keys(branches).length ? { numberType: numberType2, countVar, branches } : null;
}
var icuValueCodec = {
  parseValue: (value) => parseIcuPlural(value),
  serializeValue(model) {
    const keyword = model.numberType === "ordinal" ? "selectordinal" : "plural";
    const body = orderedBranchKeys(model.branches).map((key) => `${key} {${model.branches[key]}}`).join(" ");
    return `{${model.countVar}, ${keyword}, ${body}}`;
  },
  // ICU mandates `other` for every plural, regardless of locale.
  ...cldrValueCodecDefaults
};
var icuMessageFormat = {
  id: "icu",
  interpolation: { open: "{", close: "}", number: "#" },
  expandPluralKeypaths: (baseKey) => [baseKey],
  valueCodec: icuValueCodec
};


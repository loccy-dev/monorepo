var DEPRECATED_STYLEGUIDE_FIELDS = {
  code: "renamed to keys",
  global: "split into product, voice and mechanics, by what each rule is about",
  locales: "renamed to localeRules"
};
function firstIssueIn(error) {
  const issue = error.issues[0];
  if (!issue) return "does not match the schema";
  const path5 = issue.path.join(".");
  return path5 ? `${path5}: ${issue.message}` : issue.message;
}
function parseStyleguide(raw) {
  if (typeof raw !== "object" || Array.isArray(raw)) {
    return {
      styleguide: {},
      dropped: [{ field: "styleguide", reason: "must be a block of rules, not a single value" }]
    };
  }
  const styleguide = {};
  const dropped = [];
  for (const [field, value] of Object.entries(raw)) {
    if (value == null) continue;
    const schema2 = styleguideFieldSchemas.get(field);
    if (!schema2) {
      dropped.push({ field, reason: DEPRECATED_STYLEGUIDE_FIELDS[field] ?? "not a styleguide field" });
      continue;
    }
    const parsed = schema2.safeParse(value);
    if (parsed.success) styleguide[field] = parsed.data;
    else dropped.push({ field, reason: firstIssueIn(parsed.error) });
  }
  return { styleguide, dropped };
}
var DEFAULT_MODULE = "default";
function resolveModule(name, user, base) {
  const frameworkId = user.framework ?? base?.framework ?? "custom";
  const framework = getFramework(frameworkId);
  const known = activeFrameworkIds().join(", ");
  if (!framework) {
    throw new LoccyConfigError(`modules.${name}.framework must be a registered framework id (known: ${known})`);
  }
  if (DISABLED_FRAMEWORK_IDS.has(frameworkId)) {
    throw new LoccyConfigError(
      `modules.${name}.framework "${frameworkId}" is temporarily unsupported \u2014 supported: ${known}`
    );
  }
  const glob = user.translations?.glob ?? base?.translations.glob;
  if (!glob) {
    throw new LoccyConfigError(
      `modules.${name}.translations.glob is required \u2014 the glob for this module's translation files (e.g. "src/locales/**/*.json")`
    );
  }
  const layout = user.translations?.layout ?? base?.translations.layout ?? frameworkDefaultLayout(frameworkId, extractFileExt(glob) || "json");
  const frameworkOverridden = !!user.framework && !!base && user.framework !== base.framework;
  const messageFormat = user.translations?.messageFormat ?? (base && !frameworkOverridden ? base.translations.messageFormat : void 0) ?? framework.messageFormats[0];
  if (!getMessageFormat(messageFormat)) {
    const known2 = listMessageFormats().map((messageFormat2) => messageFormat2.id).join(", ");
    throw new LoccyConfigError(
      `modules.${name}.translations.messageFormat must be a registered message-format id (known: ${known2})`
    );
  }
  const usages = {
    // A module that declares no `usages` is translations-only — leave `include` empty (usage scanning
    // + usage-based lint skip it) rather than borrowing the placeholder default. The default module
    // still gets usages (its `base` is the detected/placeholder config), so single-setup repos scan.
    include: user.usages?.include?.length ? user.usages.include : base?.usages.include ?? [],
    exclude: user.usages?.exclude ?? base?.usages.exclude ?? [],
    customTFunctions: user.usages?.customTFunctions ?? base?.usages.customTFunctions ?? [],
    detectKeysInStrings: user.usages?.detectKeysInStrings ?? base?.usages.detectKeysInStrings ?? true,
    quoteType: user.usages?.quoteType ?? base?.usages.quoteType,
    defaultNamespace: user.usages?.defaultNamespace ?? base?.usages.defaultNamespace,
    // Usage-side lint rules (co-located with the axis they check). Default on.
    noUnresolvedKeys: user.usages?.noUnresolvedKeys ?? base?.usages.noUnresolvedKeys ?? true,
    noUnusedKeys: user.usages?.noUnusedKeys ?? base?.usages.noUnusedKeys ?? true
  };
  return {
    name,
    framework: frameworkId,
    usages,
    translations: {
      messageFormat,
      glob,
      layout,
      exclude: user.translations?.exclude ?? base?.translations.exclude ?? [],
      // Storage-side lint rules (co-located). `noUntranslatedKeys`/`checkPlurals` on by default, `sortKeys` off.
      noUntranslatedKeys: user.translations?.noUntranslatedKeys ?? base?.translations.noUntranslatedKeys ?? true,
      checkPlurals: user.translations?.checkPlurals ?? base?.translations.checkPlurals ?? true,
      sortKeys: user.translations?.sortKeys ?? base?.translations.sortKeys ?? false
    }
  };
}
function hasExplicitModules(user) {
  return !!user.modules && Object.keys(user.modules).length > 0;
}
function resolveConfig(user, detected) {
  const usesExplicitModules = hasExplicitModules(user);
  const base = detected ?? (usesExplicitModules ? null : placeholderConfig);
  const userModules = usesExplicitModules ? user.modules : { [DEFAULT_MODULE]: {} };
  const modules = {};
  for (const [name, userModule] of Object.entries(userModules)) {
    modules[name] = resolveModule(name, userModule, base?.modules[name]);
  }
  const authored = user.styleguide != null ? parseStyleguide(user.styleguide) : null;
  const styleguide = authored ? authored.styleguide : base?.styleguide;
  const dropped = [...authored?.dropped ?? [], ...pruneBrokenOverrides(styleguide)];
  return { modules, styleguide, droppedStyleguideFields: dropped.length ? dropped : void 0 };
}
function brokenOverrideReason(locale, extendsLocale) {
  if (!locale || !extendsLocale) return "a partial override needs both a locale key and `extends`";
  if (locale === extendsLocale) return `"${locale}" cannot extend itself`;
  return null;
}
function pruneBrokenOverrides(styleguide) {
  const rules = styleguide?.localeRules;
  if (!rules) return [];
  const dropped = [];
  for (const { locale, extends: extendsLocale } of partialOverridesOf(rules)) {
    const reason = brokenOverrideReason(locale, extendsLocale);
    if (!reason) continue;
    dropped.push({ field: `localeRules.${locale}`, reason });
    delete rules[locale];
  }
  return dropped;
}
async function readConfigFile(platform, configPath = loccyConfigFilename) {
  if (!await platform.exists(configPath)) {
    return null;
  }
  const content = await platform.readFile(configPath);
  let parsed;
  try {
    parsed = load(content);
  } catch (e) {
    throw new LoccyConfigError(`failed to parse ${configPath}: ${e.message}`);
  }
  if (parsed === void 0 || parsed === null) {
    parsed = {};
  } else if (typeof parsed !== "object" || Array.isArray(parsed)) {
    throw new LoccyConfigError(`${configPath} must be a YAML object`);
  }
  const user = parsed;
  const detected = hasExplicitModules(user) ? null : await initializeConfig(platform);
  return resolveConfig(user, detected);
}

// ../../packages/shared/src/core/resources/organization-parser.ts
var LOCALE_PATTERN2 = "(?<locale>[a-zA-Z]{2}(?:-[a-zA-Z]{2,})?)";
var NAMESPACE_SINGLE = "(?<namespace>[^/]+)";
var NAMESPACE_GREEDY = "(?<namespace>.+)";
function buildRegex(organization) {
  const segments = organization.split("/");
  const regexParts = [];
  for (const segment of segments) {
    if (segment === "{locale}" || segment.includes("{locale}")) {
      const escaped = escapeRegExp(segment).replace("\\{locale\\}", LOCALE_PATTERN2);
      regexParts.push(escaped);
    } else if (segment === "{namespace}**" || segment.includes("{namespace}**")) {
      const escaped = escapeRegExp(segment).replace("\\{namespace\\}\\*\\*", NAMESPACE_GREEDY);
      regexParts.push(escaped);
    } else if (segment === "{namespace}" || segment.includes("{namespace}")) {
      const escaped = escapeRegExp(segment).replace("\\{namespace\\}", NAMESPACE_SINGLE);
      regexParts.push(escaped);
    } else {
      regexParts.push(segment.replace(/[.+?^${}()|[\]\\]/g, "\\$&").replace(/\*/g, "[^/]+"));
    }
  }
  return new RegExp("^" + regexParts.join("/") + "$");
}
function parseOrganization(organization, relFile) {
  const regex2 = buildRegex(organization);
  const match = relFile.match(regex2);
  if (match?.groups?.locale) {
    return { locale: match.groups.locale, namespace: match.groups.namespace };
  }
  return null;
}
function buildPathFromOrganization(organization, locale, namespace) {
  let result = organization;
  if (organization.includes("{locale}")) {
    result = result.replace("{locale}", locale);
  }
  if (result.includes("{namespace}**")) {
    result = result.replace("{namespace}**", namespace ?? "");
  }
  result = result.replace("{namespace}", namespace ?? "");
  return result;
}
function parseLayout(layout, relFile) {
  if (typeof layout === "string") return parseOrganization(layout, relFile);
  for (const [locale, pattern2] of Object.entries(layout)) {
    if (locale === "*") continue;
    const match = relFile.match(buildRegex(pattern2));
    if (match) return { locale: match.groups?.locale ?? locale, namespace: match.groups?.namespace };
  }
  const fallback = layout["*"];
  return fallback ? parseOrganization(fallback, relFile) : null;
}
function buildPathFromLayout(layout, locale, namespace) {
  if (typeof layout === "string") return buildPathFromOrganization(layout, locale, namespace);
  const pattern2 = layout[locale] ?? layout["*"] ?? Object.values(layout)[0] ?? "";
  return buildPathFromOrganization(pattern2, locale, namespace);
}

// ../../packages/shared/src/core/resources/resource-queries.ts
function getTranslationsPerLocale(mergedData, ns) {
  return Object.fromEntries(Object.entries(mergedData).map(([locale, nsData]) => [locale, nsData[ns] ?? {}]));
}
function getFlatTranslationsPerLocale(mergedData, ns) {
  return Object.fromEntries(
    Object.entries(mergedData).map(([locale, nsData]) => [locale, flattenObject(nsData[ns] ?? {})])
  );
}
function getTranslationsPerKeypath(mergedData, ns) {
  const merged = {};
  for (const [locale, nsData] of Object.entries(mergedData)) {
    const flattened = flattenObject(nsData[ns] ?? {});
    Object.entries(flattened).forEach(([path5, value]) => {
      const existing = get_default(merged, path5, {});
      set_default(merged, path5, { ...existing, [locale]: value });
    });
  }
  return merged;
}
function getFlatTranslationsPerKeypath(flatTranslationsPerLocale) {
  const result = {};
  for (const [locale, translationPerKeypath] of Object.entries(flatTranslationsPerLocale)) {
    for (const [keypath, translation] of Object.entries(translationPerKeypath)) {
      if (!(keypath in result)) {
        result[keypath] = {};
      }
      result[keypath][locale] = translation;
    }
  }
  return result;
}


function traceInvocation(argv) {
  if (!debugEnabled()) return;
  const started = Date.now();
  const out = [];
  const err = [];
  const tee = (target, original) => {
    return (...args) => {
      target.push(args.map(String).join(" "));
      original(...args);
    };
  };
  console.log = tee(out, console.log.bind(console));
  console.error = tee(err, console.error.bind(console));
  process.on("exit", (code) => {
    const lines = [
      `
[${stamp()}] loccy-tool ${argv.slice(2).join(" ")}`,
      `  cwd: ${process.cwd()}`,
      `  exit: ${code} (${Date.now() - started}ms)`
    ];
    if (stdinSeen !== null) lines.push(`  stdin:
${indent(clip(stdinSeen))}`);
    if (out.length) lines.push(`  stdout:
${indent(clip(out.join("\n")))}`);
    if (err.length) lines.push(`  stderr:
${indent(clip(err.join("\n")))}`);
    append(`${lines.join("\n")}
`);
  });
}

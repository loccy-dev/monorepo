var COMMON_LOCALES_UNDERSCORED = new Set(Array.from(COMMON_LOCALES).map((locale) => locale.replace("-", "_")));
var LOCALE_PATTERN = /^[a-z]{2}([-_][A-Z]{2})?$/i;
function isLocaleLike(str2) {
  if (!str2 || str2.length < 2 || str2.length > 15) {
    return false;
  }
  const lowerStr = str2.toLowerCase();
  for (const locale of /* @__PURE__ */ new Set([...COMMON_LOCALES, ...COMMON_LOCALES_UNDERSCORED])) {
    if (locale.toLowerCase() === lowerStr) {
      return true;
    }
  }
  return LOCALE_PATTERN.test(str2);
}
function getLocaleRank(localeCode) {
  let rank = allSupportedLanguages.findIndex((supported) => supported.code === localeCode);
  if (rank === -1) {
    rank = allSupportedLanguages.length;
  }
  return rank;
}
function getSortedLocales(locales) {
  return [...locales].sort((a, b) => getLocaleRank(a) - getLocaleRank(b));
}
function classifyPathStructure(path5) {
  const filename = extractFileName(path5, false);
  const dirParts = extractDirname(path5).split("/");
  return {
    hasLocaleLikeDir: dirParts.some((dirPart) => isLocaleLike(dirPart)),
    isFilenameLocale: isLocaleLike(filename)
  };
}
function looksLikeNamespaceStructure(path5) {
  const { hasLocaleLikeDir, isFilenameLocale } = classifyPathStructure(path5);
  return hasLocaleLikeDir && !isFilenameLocale;
}
function looksLikeLocaleStructure(path5) {
  const { hasLocaleLikeDir, isFilenameLocale } = classifyPathStructure(path5);
  return isFilenameLocale && !hasLocaleLikeDir;
}

// ../../packages/shared/src/core/loccy-config/defaults-detection/detect-default-ns.ts
function detectDefaultNsFromResources(translationFileRelativePaths, prioritizeNamespaces) {
  if (translationFileRelativePaths.length === 0) {
    return NS_WITHOUT_NS;
  }
  const namespacedFiles = translationFileRelativePaths.filter(looksLikeNamespaceStructure);
  if (namespacedFiles.length === 0) {
    return NS_WITHOUT_NS;
  }
  const namespaces = namespacedFiles.map((filePath) => extractFileName(filePath, false));
  if (prioritizeNamespaces) {
    for (const prioritized of prioritizeNamespaces) {
      if (namespaces.includes(prioritized)) {
        return prioritized;
      }
    }
  }
  return mostCommon(namespaces) ?? NS_WITHOUT_NS;
}


function createNodePlatform(rootPath) {
  return {
    rootPath,
    async readFile(relativePath) {
      return fs4.readFile(path4.join(rootPath, relativePath), "utf-8");
    },
    async writeFile(relativePath, content) {
      const fullPath = path4.join(rootPath, relativePath);
      await fs4.mkdir(path4.dirname(fullPath), { recursive: true });
      await fs4.writeFile(fullPath, content, "utf-8");
    },
    async deleteFile(relativePath) {
      await fs4.rm(path4.join(rootPath, relativePath), { force: true });
    },
    async exists(relativePath) {
      try {
        await fs4.access(path4.join(rootPath, relativePath));
        return true;
      } catch {
        return false;
      }
    },
    async findFiles(patterns, exclude) {
      return globby(patterns, {
        cwd: rootPath,
        ignore: [...DEFAULT_IGNORE_GLOBS, ...exclude ?? []],
        gitignore: true,
        absolute: false,
        onlyFiles: true,
        dot: true
      });
    }
  };
}


var normalizeGitConfigConditionPattern = (pattern2, configFilePath) => {
  if (pattern2.startsWith("~/")) {
    pattern2 = path3.join(os.homedir(), pattern2.slice(2));
  } else if (pattern2.startsWith("./")) {
    pattern2 = path3.resolve(path3.dirname(configFilePath), pattern2.slice(2));
  } else if (!path3.isAbsolute(pattern2)) {
    pattern2 = `**/${pattern2}`;
  }
  if (pattern2.endsWith("/")) {
    pattern2 += "**";
  }
  return slash(pattern2);
};
var gitConfigGlobToRegex = (pattern2, flags) => {
  let regex2 = "";
  for (let index = 0; index < pattern2.length; index++) {
    const character = pattern2[index];
    const nextCharacter = pattern2[index + 1];
    const nextNextCharacter = pattern2[index + 2];
    if (character === "*" && nextCharacter === "*" && nextNextCharacter === "/") {
      regex2 += "(?:.*/)?";
      index += 2;
      continue;
    }
    if (character === "*" && nextCharacter === "*") {
      regex2 += ".*";
      index += 1;
      continue;
    }
    if (character === "*") {
      regex2 += "[^/]*";
      continue;
    }
    if (character === "?") {
      regex2 += "[^/]";
      continue;
    }
    if (character === "[") {
      const closingBracketIndex = pattern2.indexOf("]", index + 1);
      if (closingBracketIndex !== -1) {
        const bracketContent = pattern2.slice(index + 1, closingBracketIndex);
        if (bracketContent) {
          const negatedBracketContent = bracketContent[0] === "!" ? `^${bracketContent.slice(1)}` : bracketContent;
          regex2 += `[${negatedBracketContent}]`;
          index = closingBracketIndex;
          continue;
        }
      }
    }
    regex2 += /[|\\{}()[\]^$+?.]/.test(character) ? `\\${character}` : character;
  }
  try {
    return new RegExp(`^${regex2}$`, flags);
  } catch {
    return /(?!)/;
  }
};
var matchesIncludeIfCondition = (condition, gitDirectory, configFilePath) => {
  if (!gitDirectory) {
    return false;
  }
  const match = condition.match(/^(gitdir|gitdir\/i):(.*)$/i);
  if (!match) {
    return false;
  }
  const [, keyword, rawPattern] = match;
  const pattern2 = normalizeGitConfigConditionPattern(rawPattern.trim(), configFilePath);
  const isCaseInsensitive = keyword.toLowerCase() === "gitdir/i";
  const regularExpression = gitConfigGlobToRegex(pattern2, isCaseInsensitive ? "i" : void 0);
  const normalizedGitDirectory = slash(path3.resolve(gitDirectory));
  return regularExpression.test(normalizedGitDirectory);
};
var shouldIncludeConfigSection = (section, gitDirectory, configFilePath) => {
  if (section?.toLowerCase() === "include") {

var import_php_parser = __toESM(require_src(), 1);
function parsePhp(content) {
  const engine = new import_php_parser.Engine({ parser: { extractDoc: false, suppressErrors: false }, ast: { withPositions: false } });
  return engine.parseCode(content, "resource.php");
}
var isArrayNode = (node) => node.kind === "array";
var isStringNode = (node) => node.kind === "string";
var isNumberNode = (node) => node.kind === "number";
var isBooleanNode = (node) => node.kind === "boolean";
var isEntryNode = (node) => node.kind === "entry";
function extractRootArray(program2) {
  const returnStatement = program2.children.find((c) => c.kind === "return");
  if (!returnStatement?.expr || !isArrayNode(returnStatement.expr)) {
    throw new Error("PHP resource file must be `<?php return [...];`");
  }
  return returnStatement.expr;
}
function evalNode(node) {
  if (isArrayNode(node)) return evalArray(node);
  if (isStringNode(node)) return node.value;
  if (isNumberNode(node)) return Number(node.value);
  if (isBooleanNode(node)) return node.value;
  if (node.kind === "nullkeyword") return null;
  throw new Error(`Unsupported PHP value: ${node.kind}`);
}
function evalArray(node) {
  const items = node.items ?? [];
  const isList = items.length > 0 && items.every((item) => isEntryNode(item) && item.key === null);
  if (isList) {
    return items.map((item) => evalNode(item.value));
  }
  const obj = {};
  for (const item of items) {
    if (!isEntryNode(item) || !item.key || !isStringNode(item.key)) continue;
    obj[item.key.value] = evalNode(item.value);
  }
  return obj;
}
function escapePhpSingleQuoted(str2) {
  return str2.replace(/\\/g, "\\\\").replace(/'/g, "\\'");
}
function serializePhpValue(value, indentString2, depth) {
  const pad = indentString2.repeat(depth + 1);
  const closePad = indentString2.repeat(depth);
  if (value === null || value === void 0) return "null";
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") return String(value);
  if (typeof value === "string") return `'${escapePhpSingleQuoted(value)}'`;
  if (Array.isArray(value)) {
    if (value.length === 0) return "[]";
    const items2 = value.map((v) => `${pad}${serializePhpValue(v, indentString2, depth + 1)},`).join("\n");
    return `[
${items2}
${closePad}]`;
  }
  const entries = Object.entries(value);
  if (entries.length === 0) return "[]";
  const items = entries.map(([k, v]) => `${pad}'${escapePhpSingleQuoted(k)}' => ${serializePhpValue(v, indentString2, depth + 1)},`).join("\n");
  return `[
${items}
${closePad}]`;
}
